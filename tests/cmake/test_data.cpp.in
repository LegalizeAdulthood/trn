#include <config/common.h>
#include <util/env.h>
#include <trn/util.h>
#include <util/util2.h>

#include "mock_env.h"
#include "test_config.h"

#include <algorithm>
#include <stdlib.h>
#include <string>

namespace trn
{
namespace testing
{

namespace
{

std::string s_test_data_dir{"@TRN_TEST_DATA_DIR@"};

std::string make_test_data_path(const char *relative)
{
    std::string result{s_test_data_dir};
    if (!result.empty() && result.back() != '/')
    {
        result += '/';
    }
    result += relative;
    return result;
}

} // namespace

void set_test_data_dir(std::string dir)
{
    std::replace(dir.begin(), dir.end(), '\\', '/');
    s_test_data_dir = dir;
}

void reset_test_data_dir()
{
    s_test_data_dir = "@TRN_TEST_DATA_DIR@";
}

std::string test_data_dir()
{
    return s_test_data_dir;
}

std::string test_home_dir()
{
    return make_test_data_path("home");
}

std::string test_home_dir_capitalized()
{
    return make_test_data_path("Home");
}

std::string test_tmp_dir()
{
    return make_test_data_path("tmp");
}

std::string test_trn_dir()
{
    return make_test_data_path("trn");
}

std::string test_dot_dir()
{
    return make_test_data_path("dot");
}

std::string test_lib_dir()
{
    return make_test_data_path("lib");
}

std::string test_rn_lib_dir()
{
    return make_test_data_path("rn_lib");
}

std::string test_orgfile()
{
    return make_test_data_path("organization");
}

std::string test_newsgroup_dir()
{
    return make_test_data_path("spool/@TRN_TEST_NEWSGROUP_SUBDIR@");
}

std::string test_article_file()
{
    return test_newsgroup_dir() + "/@TRN_TEST_ARTICLE_NUM@";
}

void set_envars(MockEnvironment &env)
{
    env.expect_env("HOME", test_home_dir().c_str());
    env.expect_env("TMPDIR", test_tmp_dir().c_str());
    env.expect_env("USER", "@TRN_TEST_LOGIN_NAME@");
    env.expect_env("DOTDIR", test_dot_dir().c_str());
    env.expect_env("TRNDIR", test_trn_dir().c_str());
}

bool set_name(char *)
{
    g_login_name = "@TRN_TEST_LOGIN_NAME@";
    g_real_name = "@TRN_TEST_REAL_NAME@";
    return true;
};

bool set_host_name(char *)
{
    g_local_host = "@TRN_TEST_LOCAL_HOST@";
    g_p_host_name = "@TRN_TEST_P_HOST_NAME@";
    return true;
};

void reset_lib_dirs()
{
    g_lib = test_lib_dir();
    g_rn_lib = test_rn_lib_dir();
}

} // namespace testing
} // namespace trn
