function(check_speller helper output_dir case)
    file(REMOVE_RECURSE "${output_dir}")
    file(MAKE_DIRECTORY "${output_dir}/temporary")
    set(draft "${output_dir}/draft one.txt")
    set(second "${output_dir}/draft two.txt")
    if(NOT WIN32)
        set(draft "${output_dir}/draft-one.txt")
        set(second "${output_dir}/draft-two.txt")
    endif()
    set(checker "${output_dir}/checker")
    set(pager "${output_dir}/pager")
    set(tool_script "${output_dir}/tool.cmake")
    file(CONFIGURE OUTPUT "${tool_script}" CONTENT [=[
math(EXPR last "${CMAKE_ARGC} - 1")
set(input "${CMAKE_ARGV${last}}")
if("$ENV{SPELLER_TOOL}" STREQUAL "pager")
    file(READ "$ENV{SPELLER_WORDS}" words)
    if(NOT words MATCHES "mispelled")
        message(FATAL_ERROR "Pager did not receive the word list")
    endif()
    file(WRITE "$ENV{SPELLER_PAGED}" "paged")
else()
    file(READ "${input}" text)
    file(WRITE "$ENV{SPELLER_CAPTURE}" "${text}")
    if(text MATCHES "protected|signature|quoted")
        message(FATAL_ERROR "Checker received protected text")
    endif()
    if(NOT CMAKE_ARGV3 STREQUAL "$ENV{SPELLER_EXPECT_OPTION}")
        message(FATAL_ERROR "Checker options were not passed intact")
    endif()
    if("$ENV{SPELLER_MODE}" STREQUAL "failure" OR "$ENV{SPELLER_MODE}" STREQUAL "cancel")
        file(WRITE "${input}" "damaged temporary draft\n")
        message(FATAL_ERROR "Checker failed or was cancelled")
    elseif("$ENV{SPELLER_MODE}" STREQUAL "words")
        execute_process(COMMAND "@CMAKE_COMMAND@" -E echo mispelled)
    elseif(NOT "$ENV{SPELLER_MODE}" STREQUAL "clean")
        string(REPLACE "mispelled" "corrected" text "${text}")
        if("$ENV{SPELLER_MODE}" STREQUAL "insert")
            string(REPLACE "anchor\n" "inserted\nanchor\n" text "${text}")
        elseif("$ENV{SPELLER_MODE}" STREQUAL "delete")
            string(REPLACE "remove me\n" "" text "${text}")
        endif()
        file(CONFIGURE OUTPUT "${input}" CONTENT "${text}" @ONLY NEWLINE_STYLE LF)
    endif()
endif()
]=] @ONLY NEWLINE_STYLE LF)
    if(WIN32)
        string(APPEND checker ".cmd")
        string(APPEND pager ".cmd")
        set(check_command "\"${CMAKE_COMMAND}\" -P \"${tool_script}\" %*")
        set(pager_command "set SPELLER_TOOL=pager\nmore > \"${output_dir}/words.txt\"\n\"${CMAKE_COMMAND}\" -P \"${tool_script}\"")
        file(CONFIGURE OUTPUT "${checker}" CONTENT "@echo off\n${check_command}\nexit /b %errorlevel%\n" @ONLY NEWLINE_STYLE CRLF)
        file(CONFIGURE OUTPUT "${pager}" CONTENT "@echo off\n${pager_command}\nexit /b %errorlevel%\n" @ONLY NEWLINE_STYLE CRLF)
    else()
        set(check_command "exec \"${CMAKE_COMMAND}\" -P \"${tool_script}\" \"$@\"")
        file(CONFIGURE OUTPUT "${checker}" CONTENT "#!/bin/sh\n${check_command}\n" @ONLY NEWLINE_STYLE LF)
        file(CONFIGURE OUTPUT "${pager}" CONTENT "#!/bin/sh\ncat > '${output_dir}/words.txt'\nexport SPELLER_TOOL=pager\nexec '${CMAKE_COMMAND}' -P '${tool_script}'\n" @ONLY NEWLINE_STYLE LF)
        file(CHMOD "${checker}" "${pager}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
    endif()
    set(original "From: protected\n\tprotected continuation\nSubject: mispelled\n mispelled continuation\nKeywords: mispelled\nSummary: mispelled\n\n> quoted mispelled\nmispelled body\nanchor\nremove me\n> quoted last\n-- \nsignature mispelled\n")
    string(REPLACE "mispelled" "corrected" expected "${original}")
    string(REPLACE "quoted corrected" "quoted mispelled" expected "${expected}")
    string(REPLACE "signature corrected" "signature mispelled" expected "${expected}")
    set(mode correct)
    set(quotechars ">")
    set(expect_failure FALSE)
    if(case STREQUAL "words" OR case STREQUAL "clean")
        set(mode "${case}")
        set(expected "${original}")
    elseif(case STREQUAL "failure" OR case STREQUAL "cancel" OR case STREQUAL "missing_tool" OR case STREQUAL "pager_failure" OR case STREQUAL "word_failure")
        set(mode "${case}")
        set(expect_failure TRUE)
        set(expected "${original}")
    elseif(case STREQUAL "insert")
        set(mode insert)
        string(REPLACE "anchor\n" "inserted\nanchor\n" expected "${expected}")
    elseif(case STREQUAL "delete")
        set(mode delete)
        string(REPLACE "remove me\n" "" expected "${expected}")
    elseif(case STREQUAL "quote_pattern")
        set(quotechars "[>|:]")
        string(REPLACE "> quoted" ": quoted" original "${original}")
        string(REPLACE "> quoted" ": quoted" expected "${expected}")
    elseif(case STREQUAL "no_quotes")
        set(quotechars "")
        string(REPLACE "> quoted" "own" original "${original}")
        string(REPLACE "> quoted mispelled" "own corrected" expected "${expected}")
        string(REPLACE "> quoted last" "own last" expected "${expected}")
    elseif(case STREQUAL "header_order")
        string(REPLACE "Keywords:" "X-Other: protected\nKeywords:" original "${original}")
        string(REPLACE "Keywords:" "X-Other: protected\nKeywords:" expected "${expected}")
    elseif(case STREQUAL "empty")
        set(original "")
        set(expected "")
    elseif(case STREQUAL "arity" OR case STREQUAL "missing_input" OR
           case STREQUAL "invalid_pattern" OR case STREQUAL "invalid_options")
        set(expect_failure TRUE)
        set(expected "${original}")
        if(case STREQUAL "invalid_pattern")
            set(quotechars "[")
        endif()
    endif()
    file(CONFIGURE OUTPUT "${draft}" CONTENT "${original}" @ONLY NEWLINE_STYLE LF)
    file(CONFIGURE OUTPUT "${second}" CONTENT "${original}" @ONLY NEWLINE_STYLE LF)
    set(ENV{ISPELL_PROGRAM} "${checker}")
    set(ENV{ISPELL_OPTIONS} "\"two words\"")
    set(ENV{SPELLER_EXPECT_OPTION} "two words")
    set(ENV{SPELL_PROGRAM} "${checker}")
    set(ENV{PAGER} "\"${pager}\"")
    if(NOT WIN32)
        set(ENV{ISPELL_OPTIONS} -x)
        set(ENV{SPELLER_EXPECT_OPTION} -x)
        set(ENV{PAGER} "${pager}")
    endif()
    set(ENV{QUOTECHARS} "${quotechars}")
    set(ENV{TMPDIR} "${output_dir}/temporary")
    set(ENV{TMP} "${output_dir}/temporary")
    set(ENV{SPELLER_MODE} "${mode}")
    set(ENV{SPELLER_CAPTURE} "${output_dir}/capture.txt")
    set(ENV{SPELLER_PAGED} "${output_dir}/paged.txt")
    set(ENV{SPELLER_WORDS} "${output_dir}/words.txt")
    set(ENV{SPELLER_TOOL} "checker")
    if(case STREQUAL "words" OR case STREQUAL "clean" OR case STREQUAL "pager_failure" OR case STREQUAL "word_failure")
        set(ENV{ISPELL_PROGRAM} none)
        if(case STREQUAL "pager_failure")
            set(ENV{SPELLER_MODE} words)
            set(ENV{PAGER} "${output_dir}/missing-pager")
        elseif(case STREQUAL "word_failure")
            set(ENV{SPELLER_MODE} failure)
        endif()
    elseif(case STREQUAL "missing_tool")
        set(ENV{ISPELL_PROGRAM} "${output_dir}/missing-checker")
    elseif(case STREQUAL "invalid_options")
        set(ENV{ISPELL_OPTIONS} "\"unfinished")
    endif()
    set(command "${helper}" "${draft}")
    if(NOT WIN32)
        set(command sh "${helper}" "${draft}")
    endif()
    if(case STREQUAL "multiple")
        list(APPEND command "${second}")
    elseif(case STREQUAL "arity")
        list(POP_BACK command)
    elseif(case STREQUAL "missing_input")
        list(POP_BACK command)
        list(APPEND command "${draft}.missing")
    endif()
    execute_process(COMMAND ${command} RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    if(expect_failure)
        if(result EQUAL 0)
            message(FATAL_ERROR "Expected failure: ${stdout} ${stderr}")
        endif()
    elseif(NOT result EQUAL 0)
        message(FATAL_ERROR "Speller failed (${result}): ${stdout} ${stderr}")
    endif()
    file(READ "${draft}" actual HEX)
    string(HEX "${expected}" expected_hex)
    if(NOT actual STREQUAL expected_hex)
        message(FATAL_ERROR "Draft mismatch: ${actual}; expected ${expected_hex}")
    endif()
    if(case STREQUAL "multiple")
        file(READ "${second}" actual HEX)
        if(NOT actual STREQUAL expected_hex)
            message(FATAL_ERROR "Second draft was not corrected")
        endif()
    endif()
    if(case STREQUAL "words" AND NOT EXISTS "${output_dir}/paged.txt")
        message(FATAL_ERROR "Word list was not paged")
    endif()
    file(GLOB leftovers "${output_dir}/temporary/*")
    if(leftovers)
        message(FATAL_ERROR "Temporary files were not cleaned: ${leftovers}")
    endif()
endfunction()

if(DEFINED TRN_TEST_SPELLER)
    check_speller("${TRN_TEST_SPELLER}" "${TRN_TEST_OUTPUT_DIR}" "${TRN_TEST_CASE}")
endif()
