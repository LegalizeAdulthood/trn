include("${TRN_CONFIGURE_DATA_CMAKE}")
include("${TRN_CONFIGURE_TRN_CMAKE}")

function(expect_equal name actual expected)
    if(NOT "${actual}" STREQUAL "${expected}")
        message(FATAL_ERROR "${name} was '${actual}', expected '${expected}'.")
    endif()
endfunction()

if("${TRN_TEST_SCENARIO}" STREQUAL "found")
    find_program_default("${CMAKE_COMMAND}" DEFAULT_TEST_PROGRAM)
    expect_equal("DEFAULT_TEST_PROGRAM" "${DEFAULT_TEST_PROGRAM}" "${CMAKE_COMMAND}")

    configure_trn_tool_path_default("/test/bin/editor" DEFAULT_TEST_EDITOR "")
    expect_equal("DEFAULT_TEST_EDITOR" "${DEFAULT_TEST_EDITOR}" "/test/bin/editor")
    configure_trn_tool_path_default("/test/bin/more" DEFAULT_TEST_PAGER "")
    expect_equal("DEFAULT_TEST_PAGER" "${DEFAULT_TEST_PAGER}" "/test/bin/more")
    configure_trn_verification_command_default(
        "/test/bin/ripem" "-d -Y fgs -i %A" DEFAULT_TEST_VERIFY_RIPEM)
    expect_equal("DEFAULT_TEST_VERIFY_RIPEM" "${DEFAULT_TEST_VERIFY_RIPEM}"
        "/test/bin/ripem -d -Y fgs -i %A")
    configure_trn_verification_command_default(
        "/test/bin/pgp" "+batchmode -m %A" DEFAULT_TEST_VERIFY_PGP)
    expect_equal("DEFAULT_TEST_VERIFY_PGP" "${DEFAULT_TEST_VERIFY_PGP}"
        "/test/bin/pgp +batchmode -m %A")

    configure_shell_start_default("/test/bin/sh")
    expect_equal("DEFAULT_SHELL_START" "${DEFAULT_SHELL_START}" "#!/test/bin/sh")
    configure_data_tool_path_default("/test/bin/diff" DEFAULT_DIFF_PROGRAM "")
    expect_equal("DEFAULT_DIFF_PROGRAM" "${DEFAULT_DIFF_PROGRAM}" "/test/bin/diff")
    configure_data_tool_path_default("/test/bin/ed" DEFAULT_ED_PROGRAM "")
    expect_equal("DEFAULT_ED_PROGRAM" "${DEFAULT_ED_PROGRAM}" "/test/bin/ed")
    configure_ispell_defaults_from_paths("/test/bin/ispell" "/test/bin/vspell")
    expect_equal("DEFAULT_ISPELL_PROGRAM" "${DEFAULT_ISPELL_PROGRAM}" "/test/bin/ispell")
    expect_equal("DEFAULT_ISPELL_OPTIONS" "${DEFAULT_ISPELL_OPTIONS}" "-x")
    configure_data_tool_path_default("/test/bin/spell" DEFAULT_SPELL_PROGRAM "")
    expect_equal("DEFAULT_SPELL_PROGRAM" "${DEFAULT_SPELL_PROGRAM}" "/test/bin/spell")
    return()
endif()

if("${TRN_TEST_SCENARIO}" STREQUAL "missing")
    configure_trn_tool_path_default("" DEFAULT_TEST_EDITOR "")
    expect_equal("DEFAULT_TEST_EDITOR" "${DEFAULT_TEST_EDITOR}" "")
    configure_trn_tool_path_default("" DEFAULT_TEST_PAGER "")
    expect_equal("DEFAULT_TEST_PAGER" "${DEFAULT_TEST_PAGER}" "")
    configure_trn_verification_command_default("" "-d -Y fgs -i %A" DEFAULT_TEST_VERIFY_RIPEM)
    expect_equal("DEFAULT_TEST_VERIFY_RIPEM" "${DEFAULT_TEST_VERIFY_RIPEM}" "")
    configure_trn_verification_command_default("" "+batchmode -m %A" DEFAULT_TEST_VERIFY_PGP)
    expect_equal("DEFAULT_TEST_VERIFY_PGP" "${DEFAULT_TEST_VERIFY_PGP}" "")

    configure_shell_start_default("")
    expect_equal("DEFAULT_SHELL_START" "${DEFAULT_SHELL_START}" "")
    configure_data_tool_path_default("" DEFAULT_DIFF_PROGRAM "")
    expect_equal("DEFAULT_DIFF_PROGRAM" "${DEFAULT_DIFF_PROGRAM}" "")
    configure_data_tool_path_default("" DEFAULT_ED_PROGRAM "")
    expect_equal("DEFAULT_ED_PROGRAM" "${DEFAULT_ED_PROGRAM}" "")
    configure_ispell_defaults_from_paths("" "")
    expect_equal("DEFAULT_ISPELL_PROGRAM" "${DEFAULT_ISPELL_PROGRAM}" "none")
    expect_equal("DEFAULT_ISPELL_OPTIONS" "${DEFAULT_ISPELL_OPTIONS}" "")
    configure_data_tool_path_default("" DEFAULT_SPELL_PROGRAM "")
    expect_equal("DEFAULT_SPELL_PROGRAM" "${DEFAULT_SPELL_PROGRAM}" "")
    return()
endif()

if("${TRN_TEST_SCENARIO}" STREQUAL "override")
    set(DEFAULT_PAGER "")
    set(PAGER "/override/bin/more" CACHE STRING "Test pager override." FORCE)
    set_config_cache_default(PAGER "${DEFAULT_PAGER}" STRING "Test pager default.")
    expect_equal("PAGER" "${PAGER}" "/override/bin/more")

    set(DEFAULT_VERIFY_RIPEM "")
    set(VERIFY_RIPEM "/override/bin/ripem %A" CACHE STRING "Test RIPEM override." FORCE)
    set_config_cache_default(
        VERIFY_RIPEM "${DEFAULT_VERIFY_RIPEM}" STRING "Test RIPEM default.")
    expect_equal("VERIFY_RIPEM" "${VERIFY_RIPEM}" "/override/bin/ripem %A")

    set(DEFAULT_VERIFY_PGP "")
    set(VERIFY_PGP "/override/bin/pgp %A" CACHE STRING "Test PGP override." FORCE)
    set_config_cache_default(VERIFY_PGP "${DEFAULT_VERIFY_PGP}" STRING "Test PGP default.")
    expect_equal("VERIFY_PGP" "${VERIFY_PGP}" "/override/bin/pgp %A")

    set(DEFAULT_SHELL_START "")
    set(DEFAULT_DIFF_PROGRAM "")
    set(DEFAULT_ED_PROGRAM "")
    set(DEFAULT_ISPELL_PROGRAM "none")
    set(DEFAULT_ISPELL_OPTIONS "")
    set(DEFAULT_SPELL_PROGRAM "")
    set(SHELL_START "#!/override/sh" CACHE STRING "Test shell override." FORCE)
    set(DIFF_PROGRAM "/override/bin/diff" CACHE STRING "Test diff override." FORCE)
    set(ED_PROGRAM "/override/bin/ed" CACHE STRING "Test ed override." FORCE)
    set(ISPELL_PROGRAM "/override/bin/ispell" CACHE STRING "Test ispell override." FORCE)
    set(ISPELL_OPTIONS "-x -Tlatin1" CACHE STRING "Test ispell options override." FORCE)
    set(SPELL_PROGRAM "/override/bin/spell" CACHE STRING "Test spell override." FORCE)
    configure_helper_tool_cache_defaults()
    expect_equal("SHELL_START" "${SHELL_START}" "#!/override/sh")
    expect_equal("DIFF_PROGRAM" "${DIFF_PROGRAM}" "/override/bin/diff")
    expect_equal("ED_PROGRAM" "${ED_PROGRAM}" "/override/bin/ed")
    expect_equal("ISPELL_PROGRAM" "${ISPELL_PROGRAM}" "/override/bin/ispell")
    expect_equal("ISPELL_OPTIONS" "${ISPELL_OPTIONS}" "-x -Tlatin1")
    expect_equal("SPELL_PROGRAM" "${SPELL_PROGRAM}" "/override/bin/spell")
    return()
endif()

message(FATAL_ERROR "Unknown tool path default test scenario '${TRN_TEST_SCENARIO}'.")
