function(check_saver_errors helper output_dir case)
    file(MAKE_DIRECTORY "${output_dir}")
    set(article "${output_dir}/article")
    set(destination "${output_dir}/saved")
    set(contents "Header: test\n\nBody\n")
    set(previous "previous\n")
    file(CONFIGURE OUTPUT "${article}" CONTENT "${contents}" @ONLY NEWLINE_STYLE LF)
    file(CONFIGURE OUTPUT "${destination}" CONTENT "${previous}" @ONLY NEWLINE_STYLE LF)
    set(arguments "${article}" . comp/test 42 1 comp.test "${destination}")
    if(TRN_TEST_HAS_ENVELOPE)
        list(APPEND arguments "From supplied@example.test Thu Jan 1 00:00:00 1970")
    endif()
    set(command cmd /d /v:off /c call "${helper}")

    function(expect_saver_failure)
        execute_process(COMMAND ${command} ${ARGN}
            RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
        if(result EQUAL 0)
            message(FATAL_ERROR "Saver ${case} unexpectedly succeeded: ${output}${error}")
        endif()
    endfunction()

    if(case STREQUAL "invalid_offset")
        foreach(offset IN ITEMS -1 bad 9223372036854775808)
            list(REMOVE_AT arguments 4)
            list(INSERT arguments 4 "${offset}")
            expect_saver_failure(${arguments})
        endforeach()
    elseif(case STREQUAL "arity")
        set(incomplete ${arguments})
        list(POP_BACK incomplete)
        expect_saver_failure(${incomplete})
        expect_saver_failure(${arguments} extra)
    elseif(case STREQUAL "missing_input")
        list(REMOVE_AT arguments 0)
        list(INSERT arguments 0 "${article}.missing")
        expect_saver_failure(${arguments})
    elseif(case STREQUAL "missing_parent")
        list(REMOVE_AT arguments 6)
        list(INSERT arguments 6 "${output_dir}/missing/saved")
        expect_saver_failure(${arguments})
    elseif(case STREQUAL "same_file")
        list(REMOVE_AT arguments 6)
        list(INSERT arguments 6 "${article}")
        expect_saver_failure(${arguments})
    else()
        message(FATAL_ERROR "Unknown saver case: ${case}")
    endif()

    file(READ "${destination}" actual HEX)
    string(HEX "${previous}" expected)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Saver ${case} changed the destination: ${actual}")
    endif()
    file(READ "${article}" actual HEX)
    string(HEX "${contents}" expected)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Saver ${case} changed the article: ${actual}")
    endif()
endfunction()

check_saver_errors("${TRN_TEST_SAVER}" "${TRN_TEST_OUTPUT_DIR}" "${TRN_TEST_CASE}")
