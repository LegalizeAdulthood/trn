function(check_norm_saver helper output_dir case)
    file(MAKE_DIRECTORY "${output_dir}")
    set(article "${output_dir}/article")
    set(destination "${output_dir}/saved")
    if(case STREQUAL "spaces" AND WIN32)
        set(article "${output_dir}/article & [literal] !.txt")
        set(destination "${output_dir}/saved & [literal] !.txt")
        get_filename_component(helper_dir "${helper}" DIRECTORY)
        set(copy_dir "${output_dir}/helper & [literal] !")
        file(MAKE_DIRECTORY "${copy_dir}")
        file(COPY "${helper}" DESTINATION "${copy_dir}")
        if(EXISTS "${helper_dir}/norm.saver.ps1")
            file(COPY "${helper_dir}/norm.saver.ps1" DESTINATION "${copy_dir}")
        endif()
        set(helper "${copy_dir}/norm.saver.cmd")
    endif()
    set(contents "Header: test\n\nBody\n")
    set(offset 0)
    set(expected "Article: 42 of comp.test\n${contents}\n\n")
    set(repetitions 1)
    if(case STREQUAL "body")
        string(FIND "${contents}" "Body" body_start)
        math(EXPR offset "${body_start} + 1")
        set(expected "Body\n\n\n")
    elseif(case STREQUAL "first_byte")
        set(offset 1)
        set(expected "${contents}\n\n")
    elseif(case STREQUAL "past_end")
        set(offset 100)
        set(expected "\n\n")
    elseif(case STREQUAL "empty")
        set(contents "")
        set(expected "Article: 42 of comp.test\n\n\n")
    elseif(case STREQUAL "append")
        set(repetitions 2)
        set(expected "previous\n${expected}${expected}")
    endif()
    file(CONFIGURE OUTPUT "${article}" CONTENT "${contents}" @ONLY NEWLINE_STYLE LF)
    if(case STREQUAL "append")
        file(CONFIGURE OUTPUT "${destination}" CONTENT "previous\n" @ONLY NEWLINE_STYLE LF)
    else()
        file(REMOVE "${destination}")
    endif()
    if(WIN32)
        set(command "${helper}")
    else()
        set(command /bin/sh "${helper}")
    endif()
    foreach(iteration RANGE 1 ${repetitions})
        execute_process(
            COMMAND ${command} "${article}" . comp/test 42 "${offset}" comp.test "${destination}"
            RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "norm.saver ${case} failed (${result}):\n${output}\n${error}")
        endif()
    endforeach()
    file(READ "${destination}" actual HEX)
    string(HEX "${expected}" expected_hex)
    if(NOT actual STREQUAL expected_hex)
        message(FATAL_ERROR "norm.saver ${case}: expected ${expected_hex}, got ${actual}")
    endif()
endfunction()

if(DEFINED TRN_TEST_NORM_SAVER)
    check_norm_saver("${TRN_TEST_NORM_SAVER}" "${TRN_TEST_OUTPUT_DIR}" "${TRN_TEST_CASE}")
endif()
