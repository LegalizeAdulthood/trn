cmake_policy(PUSH)
cmake_policy(SET CMP0054 NEW)

function(check_pnews helper tool output_dir case)
    file(REMOVE_RECURSE "${output_dir}")
    file(MAKE_DIRECTORY "${output_dir}/home" "${output_dir}/temporary" "${output_dir}/news")
    set(header "${output_dir}/header")
    set(oldarticle "${output_dir}/oldarticle")
    set(include "${output_dir}/include")
    set(body "mispelled prepared body\n.From body\n")
    if(case STREQUAL "eight_bit")
        string(ASCII 195 169 non_ascii)
        string(APPEND body "${non_ascii}\n")
    endif()
    set(article "Newsgroups: comp.test\nSubject: Re:   test subject\nUser-Agent: obsolete\nX-Newsreader: obsolete\nCc: \nSummary: \nDistribution: world\n\n${body}")
    if(case STREQUAL "email_copy" OR case STREQUAL "email_failure")
        string(REPLACE "Cc: " "Cc: recipient@example.test" article "${article}")
    elseif(case STREQUAL "poster_reply")
        string(REPLACE "comp.test" "poster" article "${article}")
        string(REPLACE "Cc: " "Cc: recipient@example.test" article "${article}")
    endif()
    if(case STREQUAL "email_copy" OR case STREQUAL "blind_copy")
        string(REPLACE "Summary: " "Bcc: hidden@example.test,\n hidden-two@example.test\nSummary: " article "${article}")
    endif()
    if(case STREQUAL "moderated_mime")
        set(article "Newsgroups: comp.test\nSubject: Re: test subject\nMIME-Version: 1.0\nContent-Type: multipart/mixed; boundary=fixture\nContent-Transfer-Encoding: 8bit\n\n--fixture\nContent-Type: text/plain\n\n${body}--fixture--\n")
    endif()
    file(CONFIGURE OUTPUT "${header}" CONTENT "${article}" @ONLY NEWLINE_STYLE LF)
    file(CONFIGURE OUTPUT "${oldarticle}" CONTENT "old article\n" @ONLY NEWLINE_STYLE LF)
    file(CONFIGURE OUTPUT "${include}" CONTENT "included body\n" @ONLY NEWLINE_STYLE LF)
    file(CONFIGURE OUTPUT "${output_dir}/news/active" CONTENT "comp.test 1 1 y\n" @ONLY NEWLINE_STYLE LF)
    file(CONFIGURE OUTPUT "${output_dir}/news/newsgroups" CONTENT "comp.test Test group\n" @ONLY NEWLINE_STYLE LF)
    file(CONFIGURE OUTPUT "${output_dir}/news/distributions" CONTENT "local Local only\n" @ONLY NEWLINE_STYLE LF)
    file(CONFIGURE OUTPUT "${output_dir}/home/.news_sig" CONTENT "signature one\nsignature two\nsignature three\nsignature four\nsignature five\n" @ONLY NEWLINE_STYLE LF)
    set(ENV{HOME} "${output_dir}/home")
    set(ENV{LOGDIR} "${output_dir}/home")
    set(ENV{DOTDIR} "${output_dir}/home")
    set(ENV{TMPDIR} "${output_dir}/temporary")
    set(ENV{TMP} "${output_dir}/temporary")
    set(ENV{USER} test)
    set(ENV{LOGNAME} test)
    set(ENV{NAME} "Test User")
    set(ENV{NEWSORG} "Test Organization")
    set(ENV{NEWSLIB} "${output_dir}/news")
    set(ENV{REPLYTO} "reply@example.test")
    set(ENV{FAST_PNEWS} yes)
    set(ENV{TRN_VERSION} 5.0)
    set(ENV{LC_ALL} C.UTF-8)
    set(ENV{LC_CTYPE} C.UTF-8)
    set(ENV{LANG} C.UTF-8)
    set(ENV{NEWSACTIVE} "${output_dir}/news/active")
    set(ENV{NEWSDESCRIPTIONS} "${output_dir}/news/newsgroups")
    set(ENV{NEWSSIGNATURE} "${output_dir}/home/.news_sig")
    set(ENV{NETSPEED} 0)
    set(ENV{RNMAILER} "${tool} mailer")
    set(ENV{PGPCOMMAND} "")
    set(ENV{AUTHORCOPY} none)
    set(ENV{POSTSAVER} "")
    set(ENV{PNEWS_TEST_DIRECTORY} "${output_dir}")
    set(ENV{PNEWS_TEST_MODE} "${case}")
    set(ENV{ISPELL_PROGRAM} "${tool}")
    set(ENV{ISPELL_OPTIONS} spell)
    set(ENV{QUOTECHARS} ">")
    if(WIN32)
        set(ENV{RNMAILER} "\"${tool}\" mailer")
        file(CONFIGURE OUTPUT "${output_dir}/account.json" CONTENT "{\"url\":\"smtps://smtp.example.test:465\",\"sender\":\"author@example.test\"}" @ONLY NEWLINE_STYLE LF)
        set(ENV{RNMAILER_CONFIG} "${output_dir}/account.json")
        set(ENV{NEWSMODERATORS} "${output_dir}/news/moderators")
        file(CONFIGURE OUTPUT "${output_dir}/news/moderators" CONTENT "comp.*:moderator@example.test\n" @ONLY NEWLINE_STYLE LF)
        set(ENV{VISUAL} "\"${tool}\" editor \"two words\"")
        set(ENV{EDITOR} "${tool}.missing")
        set(ENV{PAGER} "\"${tool}\" pager")
        set(ENV{INEWS} "\"${tool}\" poster")
        set(ENV{ARTCHECK} "\"${tool}\" artcheck")
        set(ENV{NNTPLIST} "\"${tool}\" nntplist")
        set(command "${helper}" -h "${header}" "${oldarticle}")
    else()
        set(ENV{VISUAL} "${tool} editor")
        set(ENV{EDITOR} "${tool}.missing")
        set(ENV{PAGER} "${tool} pager")
        set(PRIVATE_LIB "${output_dir}/private")
        set(NEWS_LIB "${output_dir}/news")
        set(SHELL_START "#!/bin/sh")
        set(BIN_DIR "${output_dir}/tools")
        set(USE_INEWS "${tool} poster")
        set(DEFAULT_EDITOR "${tool} editor")
        set(NAME_TYPE other)
        set(PAGER "${tool} pager")
        set(ISPELL_PROGRAM "${tool}")
        set(ISPELL_OPTIONS spell)
        set(DIFF_PROGRAM /usr/bin/diff)
        set(ED_PROGRAM /usr/bin/ed)
        set(LOCAL_DIST local)
        set(MBOX_CHAR F)
        string(ASCII 1 CTRL_A)
        foreach(setting IN ITEMS ORGANIZATION_DIST CITY_DIST STATE_DIST MULTISTATE_DIST COUNTRY_DIST CONTINENT_DIST)
            set(${setting} none)
        endforeach()
        set(POSTING_ORG_NAME "Test Organization")
        set(helper "${output_dir}/Pnews")
        configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../data/Pnews.in" "${helper}" @ONLY NEWLINE_STYLE UNIX)
        configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../data/Pnews.header.in" "${PRIVATE_LIB}/Pnews.header" @ONLY NEWLINE_STYLE UNIX)
        configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../data/Speller.in" "${PRIVATE_LIB}/Speller" @ONLY NEWLINE_STYLE UNIX)
        configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../data/mbox.saver.in" "${PRIVATE_LIB}/mbox.saver" @ONLY NEWLINE_STYLE UNIX)
        file(CHMOD "${PRIVATE_LIB}/Speller" "${PRIVATE_LIB}/mbox.saver" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
        foreach(role IN ITEMS artcheck nntplist)
            set(name "${role}")
            if(role STREQUAL "artcheck")
                set(name trn-artchk)
            endif()
            file(CONFIGURE OUTPUT "${BIN_DIR}/${name}" CONTENT "#!/bin/sh\nexec '${tool}' ${role} \"$@\"\n" @ONLY NEWLINE_STYLE LF)
            file(CHMOD "${BIN_DIR}/${name}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
        endforeach()
        set(command sh "${helper}" -h "${header}" "${oldarticle}")
    endif()
    set(input "s\n")
    set(expect_post TRUE)
    set(expect_failure FALSE)
    if(case STREQUAL "arguments" OR case STREQUAL "interactive" OR case STREQUAL "distribution" OR case STREQUAL "inclusion")
        if(WIN32)
            set(command "${helper}")
        else()
            set(command sh "${helper}")
        endif()
        if(case STREQUAL "arguments")
            list(APPEND command "comp.test" "argument title")
            set(input "\ns\n")
        else()
            set(input "comp.test\n\ninteractive title\ns\n")
        endif()
        if(case STREQUAL "distribution")
            set(input "comp.test\nlocal\nlocal title\ns\n")
        elseif(case STREQUAL "inclusion")
            set(ENV{FAST_PNEWS} no)
            set(input "comp.test\n\nincluded title\ny\n${include}\ns\n")
        endif()
    elseif(case STREQUAL "loop")
        set(input "l\nc\ne\ns\n")
    elseif(case STREQUAL "abort" OR case STREQUAL "eof")
        set(expect_post FALSE)
        set(input "a\n")
        if(case STREQUAL "eof")
            set(input "")
        endif()
    elseif(case STREQUAL "authorcopy" OR case STREQUAL "saver" OR case STREQUAL "saver_failure")
        set(ENV{AUTHORCOPY} "${output_dir}/saved")
        if(NOT case STREQUAL "authorcopy")
            set(ENV{POSTSAVER} "\"${tool}\" saver")
            if(NOT WIN32)
                set(ENV{POSTSAVER} "${tool} saver")
            endif()
        endif()
        if(case STREQUAL "saver_failure")
            set(expect_failure TRUE)
        endif()
    elseif(case MATCHES "^(editor|artcheck|poster|nntplist|spell|pager|pgp)_(failure|cancel)$" OR case STREQUAL "missing_tool")
        set(expect_post FALSE)
        set(expect_failure TRUE)
        set(input "s\na\n")
        if(case MATCHES "^spell")
            set(input "c\na\n")
        elseif(case MATCHES "^pager")
            set(input "l\na\n")
        elseif(case MATCHES "^pgp")
            set(input "ps\na\n")
        elseif(case MATCHES "^nntplist")
            set(ENV{NETSPEED} fast)
            set(ENV{NEWSACTIVE} none)
            set(ENV{NEWSDESCRIPTIONS} none)
        elseif(case STREQUAL "missing_tool")
            set(ENV{VISUAL} "${tool}.missing")
        endif()
    elseif(case STREQUAL "pgp")
        set(input "ps test-user\npt\npu\ns\n")
    elseif(case STREQUAL "fetch")
        set(ENV{NETSPEED} fast)
        set(ENV{NEWSACTIVE} none)
        set(ENV{NEWSDESCRIPTIONS} none)
    elseif(case MATCHES "^(email_copy|blind_copy|email_failure|moderated|moderated_failure|moderated_mime|poster_reply)$")
        if(NOT case MATCHES "^(email_|blind_copy)")
            set(expect_post FALSE)
        endif()
        if(case MATCHES "_failure$")
            set(expect_failure TRUE)
            set(ENV{PNEWS_TEST_MODE} mailer_failure)
            set(input "s\ns\na\n")
        endif()
        if(case MATCHES "^moderated")
            file(CONFIGURE OUTPUT "${output_dir}/news/active" CONTENT "comp.test 1 1 m\n" @ONLY NEWLINE_STYLE LF)
        endif()
    elseif(case STREQUAL "native_inews")
        set(ENV{INEWS} "")
        set(ENV{ARTCHECK} "${TRN_TEST_ARTCHECK}")
        set(ENV{AUTHORCOPY} "${output_dir}/saved")
    endif()
    if(case MATCHES "^pgp")
        set(ENV{PGPCOMMAND} "\"${tool}\" pgp")
        if(NOT WIN32)
            set(ENV{PGPCOMMAND} "${tool} pgp")
        endif()
    endif()
    file(CONFIGURE OUTPUT "${output_dir}/input" CONTENT "${input}" @ONLY NEWLINE_STYLE LF)
    execute_process(COMMAND ${command} INPUT_FILE "${output_dir}/input"
        RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 20)
    if(expect_failure AND WIN32)
        if(result EQUAL 0)
            message(FATAL_ERROR "Expected a child/email failure: ${stdout} ${stderr}")
        endif()
        if((expect_failure OR case STREQUAL "abort" OR case STREQUAL "eof") AND NOT EXISTS "${output_dir}/home/dead.article")
            message(FATAL_ERROR "Failure lost the draft: ${stdout} ${stderr}")
        endif()
    elseif(NOT result EQUAL 0)
        message(FATAL_ERROR "Pnews failed (${result}): ${stdout} ${stderr}")
    endif()
    if(expect_post AND NOT case STREQUAL "native_inews")
        if(NOT EXISTS "${output_dir}/posted")
            message(FATAL_ERROR "No article posted: ${stdout} ${stderr}")
        endif()
        file(READ "${output_dir}/posted" posted)
        foreach(required IN ITEMS "Newsgroups: comp.test" "User-Agent: trn/" "Mime-Version: 1.0" "Content-Type: text/plain; charset=\"[uU][tT][fF]-8\"" "signature four")
            if(NOT posted MATCHES "${required}")
                message(FATAL_ERROR "Missing '${required}' in ${posted}")
            endif()
        endforeach()
        if(posted MATCHES "obsolete|signature five|Cc:|Bcc:|hidden@example.test|Summary:|Distribution: world")
            message(FATAL_ERROR "Obsolete/empty headers or excess signature: ${posted}")
        endif()
        if(case STREQUAL "eight_bit")
            set(transfer_encoding 8bit)
        else()
            set(transfer_encoding 7bit)
        endif()
        if(NOT posted MATCHES "Content-Transfer-Encoding: ${transfer_encoding}")
            message(FATAL_ERROR "Incorrect transfer encoding: ${posted}")
        endif()
        if(case STREQUAL "loop" AND NOT posted MATCHES "corrected prepared body")
            message(FATAL_ERROR "Spelling correction missing")
        elseif(case STREQUAL "distribution" AND NOT posted MATCHES "Distribution: local")
            message(FATAL_ERROR "Distribution was not retained")
        elseif(case STREQUAL "inclusion" AND NOT posted MATCHES "included body")
            message(FATAL_ERROR "Prepared body missing")
        elseif(case STREQUAL "arguments" AND NOT posted MATCHES "Subject: argument title")
            message(FATAL_ERROR "Argument title missing")
        endif()
    elseif(NOT expect_post)
        if(EXISTS "${output_dir}/posted")
            message(FATAL_ERROR "Unexpected posting")
        endif()
        if((expect_failure OR case STREQUAL "abort" OR case STREQUAL "eof") AND NOT EXISTS "${output_dir}/home/dead.article")
            message(FATAL_ERROR "No recoverable draft: ${stdout} ${stderr}")
        endif()
    endif()
    if(NOT EXISTS "${output_dir}/home/.article")
        message(FATAL_ERROR "No draft copy: ${stdout} ${stderr}")
    endif()
    if(case MATCHES "^(email_copy|blind_copy|moderated|moderated_mime|poster_reply)$")
        if(NOT EXISTS "${output_dir}/mailed")
            message(FATAL_ERROR "Email was not submitted: ${stdout} ${stderr}")
        endif()
        file(READ "${output_dir}/mailed" mailed)
        if(NOT mailed MATCHES "Subject: Re: test subject" OR NOT mailed MATCHES "mispelled prepared body")
            message(FATAL_ERROR "Incomplete emailed article: ${mailed}")
        endif()
        if(case MATCHES "^moderated" AND NOT mailed MATCHES "To: moderator@example.test")
            message(FATAL_ERROR "Moderator routing failed: ${mailed}")
        endif()
        if(case STREQUAL "moderated_mime" AND (NOT mailed MATCHES "Content-Type: multipart/mixed" OR NOT mailed MATCHES "Content-Transfer-Encoding: 8bit"))
            message(FATAL_ERROR "Moderated MIME headers were rewritten: ${mailed}")
        endif()
        if(case STREQUAL "email_copy" OR case STREQUAL "blind_copy")
            file(READ "${output_dir}/recipients" recipients)
            if(NOT recipients MATCHES "hidden@example.test" OR NOT recipients MATCHES "hidden-two@example.test"
                    OR mailed MATCHES "hidden@example.test|hidden-two@example.test")
                message(FATAL_ERROR "Blind-copy addresses leaked or were not submitted: ${mailed} ${recipients}")
            endif()
        endif()
    elseif(case STREQUAL "email_failure")
        file(READ "${output_dir}/tools.log" tools)
        string(REGEX MATCHALL "poster\n" posts "${tools}")
        list(LENGTH posts count)
        if(NOT count EQUAL 1)
            message(FATAL_ERROR "Mail retry reposted accepted article: ${tools}")
        endif()
    endif()
    if(case STREQUAL "header")
        file(READ "${output_dir}/tools.log" tools)
        string(FIND "${tools}" "${oldarticle}" old_position)
        if(old_position LESS 0 OR (WIN32 AND NOT tools MATCHES "two words\n"))
            message(FATAL_ERROR "Editor arguments were not preserved: ${tools}")
        endif()
    endif()
    if(case STREQUAL "pgp")
        file(READ "${output_dir}/tools.log" tools)
        string(REGEX MATCHALL "pgp\n" calls "${tools}")
        list(LENGTH calls count)
        if(count LESS 3 OR NOT tools MATCHES "-u\ntest-user\n" OR posted MATCHES "BEGIN PGP")
            message(FATAL_ERROR "PGP sign/test/unsign flow was not completed: ${tools}")
        endif()
    endif()
    if(case STREQUAL "authorcopy" OR case STREQUAL "saver")
        file(READ "${output_dir}/saved" saved)
        if(NOT saved MATCHES "mispelled prepared body" OR saved MATCHES "Article: 0")
            message(FATAL_ERROR "Incorrect author-copy record: ${saved}")
        endif()
        if(case STREQUAL "authorcopy" AND NOT saved MATCHES "^From test ")
            message(FATAL_ERROR "Missing author-copy envelope")
        endif()
    endif()
    file(GLOB leftovers "${output_dir}/temporary/*" "${output_dir}/home/.article.*")
    if(leftovers)
        message(FATAL_ERROR "Temporary files remain: ${leftovers}")
    endif()
endfunction()

if(DEFINED TRN_TEST_PNEWS)
    check_pnews("${TRN_TEST_PNEWS}" "${TRN_TEST_PNEWS_TOOL}" "${TRN_TEST_OUTPUT_DIR}" "${TRN_TEST_CASE}")
endif()
cmake_policy(POP)
