function(check_mbox_saver helper output_dir case format)
    file(MAKE_DIRECTORY "${output_dir}")
    set(article "${output_dir}/article")
    set(destination "${output_dir}/saved")
    if(case STREQUAL "spaces" AND WIN32)
        set(article "${output_dir}/article & [literal] !.txt")
        set(destination "${output_dir}/saved & [literal] !.txt")
        get_filename_component(helper_dir "${helper}" DIRECTORY)
        set(copy_dir "${output_dir}/helper & [literal] !")
        file(MAKE_DIRECTORY "${copy_dir}")
        file(COPY "${helper}" DESTINATION "${copy_dir}")
        if(EXISTS "${helper_dir}/mbox.saver.ps1")
            file(COPY "${helper_dir}/mbox.saver.ps1" DESTINATION "${copy_dir}")
        endif()
        set(helper "${copy_dir}/mbox.saver.cmd")
    endif()
    set(contents "Header: test\n\nFrom upper\nfrom lower\nFROM unchanged\n From indented\n>From quoted\nFro\n")
    set(body "From upper\nfrom lower\nFROM unchanged\n From indented\n>From quoted\nFro\n")
    set(escaped "Header: test\n\n>From upper\n>from lower\nFROM unchanged\n From indented\n>From quoted\nFro\n")
    set(offset 0)
    set(number 42)
    set(marker "Article: 42 of comp.test\n")
    set(repetitions 1)
    if(case STREQUAL "body")
        string(FIND "${contents}" "From upper" body_start)
        math(EXPR offset "${body_start} + 1")
        set(contents_to_save "${body}")
        set(escaped ">From upper\n>from lower\nFROM unchanged\n From indented\n>From quoted\nFro\n")
        set(marker "")
    elseif(case STREQUAL "first_byte")
        set(offset 1)
        set(marker "")
        set(contents_to_save "${contents}")
    elseif(case STREQUAL "past_end")
        set(offset 10000)
        set(marker "")
        set(contents_to_save "")
        set(escaped "")
    elseif(case STREQUAL "empty")
        set(contents "")
        set(contents_to_save "")
        set(escaped "")
    else()
        set(contents_to_save "${contents}")
    endif()
    if(case STREQUAL "record")
        set(number 0)
        set(marker "")
    endif()
    set(envelope "From supplied@example.test Thu Jan 1 00:00:00 1970")
    if(case STREQUAL "unicode_envelope")
        string(ASCII 195 169 accented_e)
        set(envelope "From Andr${accented_e}@example.test Thu Jan 1 00:00:00 1970")
        set(offset 1)
        set(marker "")
    endif()
    if(format STREQUAL "mmdf")
        string(ASCII 1 ctrl_a)
        set(separator "${ctrl_a}${ctrl_a}${ctrl_a}${ctrl_a}\n")
        set(expected "${separator}${marker}${contents_to_save}\n\n${separator}")
    else()
        set(expected "${envelope}\n${marker}${escaped}\n\n")
    endif()
    file(CONFIGURE OUTPUT "${article}" CONTENT "${contents}" @ONLY NEWLINE_STYLE LF)
    if(case STREQUAL "append")
        set(repetitions 2)
        set(expected "previous\n${expected}${expected}")
        file(CONFIGURE OUTPUT "${destination}" CONTENT "previous\n" @ONLY NEWLINE_STYLE LF)
    elseif(case STREQUAL "unicode_envelope")
        set(expected "previous\n${expected}")
        file(CONFIGURE OUTPUT "${destination}" CONTENT "previous\n" @ONLY NEWLINE_STYLE LF)
    else()
        file(REMOVE "${destination}")
    endif()
    if(WIN32)
        set(command cmd /d /v:off /c call "${helper}")
    else()
        set(command /bin/sh "${helper}")
    endif()
    foreach(iteration RANGE 1 ${repetitions})
        execute_process(
            COMMAND ${command} "${article}" . comp/test "${number}" "${offset}" comp.test "${destination}" "${envelope}"
            RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "mbox.saver ${format}/${case} failed (${result}):\n${output}\n${error}")
        endif()
    endforeach()
    file(READ "${destination}" actual HEX)
    string(HEX "${expected}" expected_hex)
    if(NOT actual STREQUAL expected_hex)
        message(FATAL_ERROR "mbox.saver ${format}/${case}: expected ${expected_hex}, got ${actual}")
    endif()
endfunction()

if(DEFINED TRN_TEST_MBOX_SAVER)
    check_mbox_saver("${TRN_TEST_MBOX_SAVER}" "${TRN_TEST_OUTPUT_DIR}"
        "${TRN_TEST_CASE}" "${TRN_TEST_MBOX_FORMAT}")
endif()
