cmake_policy(PUSH)
cmake_policy(SET CMP0054 NEW)
function(check_rnmail helper tool output_dir case)
    file(REMOVE_RECURSE "${output_dir}")
    file(MAKE_DIRECTORY "${output_dir}/home" "${output_dir}/temporary" "${output_dir}/private")
    set(header "${output_dir}/reply header")
    set(oldarticle "${output_dir}/old article")
    if(NOT WIN32)
        set(header "${output_dir}/reply-header")
        set(oldarticle "${output_dir}/old-article")
    endif()
    set(text "To: reader@example.test\nCc: copy@example.test\nBcc: hidden@example.test\nSubject: reply\nIn-Reply-To: <original@example.test>\n\nquoted original body\n")
    if(case STREQUAL "forward")
        set(text "To: reader@example.test\nSubject: forward\nMIME-Version: 1.0\nContent-Type: multipart/mixed; boundary=forward\n\n--forward\nContent-Type: message/rfc822\n\nSubject: original\n\nforwarded body\n--forward--\n")
    endif()
    file(CONFIGURE OUTPUT "${header}" CONTENT "${text}" @ONLY NEWLINE_STYLE LF)
    file(CONFIGURE OUTPUT "${oldarticle}" CONTENT "old article\n" @ONLY NEWLINE_STYLE LF)
    file(CONFIGURE OUTPUT "${output_dir}/include" CONTENT "prepared body\n" @ONLY NEWLINE_STYLE LF)
    foreach(name IN ITEMS HOME LOGDIR DOTDIR)
        set(ENV{${name}} "${output_dir}/home")
    endforeach()
    foreach(name IN ITEMS TMP TMPDIR)
        set(ENV{${name}} "${output_dir}/temporary")
    endforeach()
    set(ENV{PNEWS_TEST_DIRECTORY} "${output_dir}")
    set(ENV{PNEWS_TEST_MODE} "${case}")
    set(ENV{FAST_RNMAIL} yes)
    set(ENV{MAILSIGNATURE} "${output_dir}/home/.mail_sig")
    set(ENV{MAILRECORD} none)
    set(ENV{REPLYTO} reply@example.test)
    set(ENV{USER} test)
    set(ENV{LOGNAME} test)
    set(ENV{REPLYSAVER} "")
    set(ENV{QUOTECHARS} ">")
    set(MBOX_CHAR F)
    if(WIN32)
        file(COPY_FILE "${tool}" "${output_dir}/tool with spaces.exe")
        set(tool "${output_dir}/tool with spaces.exe")
        set(ENV{RNMAILER} "\"${tool}\" mailer")
        set(ENV{VISUAL} "\"${tool}\" editor \"two words\"")
        set(ENV{EDITOR} "${tool}.missing")
        set(ENV{PAGER} "\"${tool}\" pager")
        set(ENV{SPELLER} "\"${tool}\" spell")
        set(ENV{PGPCOMMAND} "\"${tool}\" pgp")
        file(CONFIGURE OUTPUT "${output_dir}/account.json" CONTENT "{\"url\":\"smtps://smtp.example.test:465\",\"sender\":\"author@example.test\",\"timeoutSeconds\":3}" @ONLY NEWLINE_STYLE LF)
        set(ENV{RNMAILER_CONFIG} "${output_dir}/account.json")
        set(command "${helper}" -h "${header}" "${oldarticle}")
    else()
        unset(ENV{REPLYSAVER})
        set(PRIVATE_LIB "${output_dir}/private")
        set(SHELL_START "#!/bin/sh")
        set(DEFAULT_EDITOR "${tool} editor")
        set(PAGER "${tool} pager")
        set(POSTING_ORG_NAME "Test Organization")
        configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../data/Rnmail.in" "${output_dir}/Rnmail" @ONLY NEWLINE_STYLE UNIX)
        configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../data/mbox.saver.in" "${PRIVATE_LIB}/mbox.saver" @ONLY NEWLINE_STYLE UNIX)
        file(CONFIGURE OUTPUT "${PRIVATE_LIB}/Speller" CONTENT "#!/bin/sh\nexec '${tool}' spell \"$@\"\n" @ONLY NEWLINE_STYLE LF)
        file(CONFIGURE OUTPUT "${output_dir}/sendmail" CONTENT "#!/bin/sh\nexec '${tool}' mailer \"$@\"\n" @ONLY NEWLINE_STYLE LF)
        file(CHMOD "${PRIVATE_LIB}/mbox.saver" "${PRIVATE_LIB}/Speller" "${output_dir}/sendmail" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
        set(ENV{RNMAILER} "${output_dir}/sendmail")
        set(ENV{VISUAL} "${tool} editor")
        set(ENV{EDITOR} "${tool}.missing")
        set(ENV{PAGER} "${tool} pager")
        set(ENV{PGPCOMMAND} "${tool} pgp")
        set(command sh "${output_dir}/Rnmail" -h "${header}" "${oldarticle}")
    endif()
    set(input "s\n")
    set(expect_mail TRUE)
    set(expect_failure FALSE)
    if(case STREQUAL "arguments" OR case STREQUAL "interactive" OR case STREQUAL "inclusion")
        if(WIN32)
            set(command "${helper}")
        else()
            set(command sh "${output_dir}/Rnmail")
        endif()
        set(input "reader@example.test\nnew subject\ns\n")
        if(case STREQUAL "arguments")
            list(APPEND command reader@example.test second@example.test)
            set(input "argument subject\ns\n")
        elseif(case STREQUAL "inclusion")
            set(ENV{FAST_RNMAIL} no)
            set(input "reader@example.test\nnew subject\n${output_dir}/include\ns\n")
        endif()
    elseif(case STREQUAL "loop")
        set(input "l\nc\ne\ns\n")
    elseif(case STREQUAL "abort" OR case STREQUAL "eof")
        set(expect_mail FALSE)
        set(input "a\n")
        if(case STREQUAL "eof")
            set(input "")
        endif()
    elseif(case STREQUAL "signature")
        file(CONFIGURE OUTPUT "${output_dir}/home/.mail_sig" CONTENT "mail signature one\ntwo\nthree\nfour\nfive\n" @ONLY NEWLINE_STYLE LF)
        file(CONFIGURE OUTPUT "${output_dir}/home/.signature" CONTENT "additional signature\n" @ONLY NEWLINE_STYLE LF)
        set(input "s\ny\n")
    elseif(case STREQUAL "record" OR case STREQUAL "saver" OR case STREQUAL "saver_failure")
        set(ENV{MAILRECORD} "${output_dir}/record")
        if(NOT case STREQUAL "record")
            set(ENV{REPLYSAVER} "\"${tool}\" saver")
            if(NOT WIN32)
                set(ENV{REPLYSAVER} "${tool} saver")
            endif()
        endif()
        if(case STREQUAL "saver_failure")
            set(expect_failure TRUE)
        endif()
    elseif(case STREQUAL "pgp")
        set(input "ps\npt\npu\npe\npb\npu\ns\n")
    elseif(case MATCHES "_(failure|cancel|unconfirmed|handoff)$" OR case STREQUAL "missing_account")
        set(expect_mail FALSE)
        set(expect_failure TRUE)
        set(input "s\na\n")
        if(case STREQUAL "missing_account")
            set(ENV{RNMAILER_CONFIG} "")
        endif()
    endif()
    file(CONFIGURE OUTPUT "${output_dir}/input" CONTENT "${input}" @ONLY NEWLINE_STYLE LF)
    execute_process(COMMAND ${command} INPUT_FILE "${output_dir}/input"
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 15)
    if(expect_failure)
        if(result EQUAL 0)
            message(FATAL_ERROR "Rnmail ${case} unexpectedly succeeded: ${out}${err}")
        endif()
    elseif(NOT result EQUAL 0)
        message(FATAL_ERROR "Rnmail ${case} failed (${result}): ${out}${err}")
    endif()
    if(NOT EXISTS "${output_dir}/home/.letter")
        message(FATAL_ERROR "Rnmail did not retain .letter: ${out}${err}")
    endif()
    if(expect_mail)
        if(NOT EXISTS "${output_dir}/mailed")
            message(FATAL_ERROR "Rnmail did not submit: ${out}${err}")
        endif()
        file(READ "${output_dir}/mailed" mailed)
        if(NOT mailed MATCHES "Subject: " OR NOT mailed MATCHES "(body|signature)")
            message(FATAL_ERROR "Incomplete mail: ${mailed}")
        endif()
        if(case STREQUAL "header" AND NOT mailed MATCHES "In-Reply-To: <original@example.test>")
            message(FATAL_ERROR "Reply header lost")
        elseif(case STREQUAL "forward" AND NOT mailed MATCHES "Content-Type: message/rfc822")
            message(FATAL_ERROR "MIME forward lost")
        elseif(case STREQUAL "signature" AND (NOT mailed MATCHES "five" OR NOT mailed MATCHES "additional signature"))
            message(FATAL_ERROR "Incomplete mail signatures")
        elseif(case STREQUAL "loop" AND NOT mailed MATCHES "corrected editor body")
            message(FATAL_ERROR "Spelling loop did not edit message")
        elseif(case STREQUAL "inclusion" AND NOT mailed MATCHES "prepared body")
            message(FATAL_ERROR "Prepared file lost")
        endif()
        if(WIN32 AND mailed MATCHES "\nBcc:")
            message(FATAL_ERROR "Bcc leaked into uploaded mail")
        endif()
        if(case STREQUAL "record" OR case STREQUAL "saver")
            file(READ "${output_dir}/record" record)
            if(NOT record MATCHES "Subject:" OR record MATCHES "Article 0")
                message(FATAL_ERROR "Bad sent-mail record: ${record}")
            endif()
        endif()
    else()
        if(NOT EXISTS "${output_dir}/home/dead.letter")
            message(FATAL_ERROR "Unaccepted draft was not rescued: ${out}${err}")
        endif()
    endif()
    file(GLOB leftovers "${output_dir}/home/.letter.*" "${output_dir}/temporary/trn-*")
    if(leftovers)
        message(FATAL_ERROR "Rnmail left temporary files: ${leftovers}")
    endif()
endfunction()
if(DEFINED TRN_TEST_RNMAIL)
    check_rnmail("${TRN_TEST_RNMAIL}" "${TRN_TEST_PNEWS_TOOL}" "${TRN_TEST_OUTPUT_DIR}" "${TRN_TEST_CASE}")
endif()
cmake_policy(POP)
