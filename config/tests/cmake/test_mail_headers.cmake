file(MAKE_DIRECTORY "${TRN_TEST_OUTPUT_DIR}")
set(draft "${TRN_TEST_OUTPUT_DIR}/draft.eml")
set(submission "${TRN_TEST_OUTPUT_DIR}/submission.eml")
set(recipients "${TRN_TEST_OUTPUT_DIR}/recipients.json")
set(addresses "${TRN_TEST_OUTPUT_DIR}/addresses.json")
set(encoded "${TRN_TEST_OUTPUT_DIR}/encoded-header")
foreach(path IN ITEMS draft submission recipients addresses encoded)
    string(REPLACE "'" "''" ${path}_quoted "${${path}}")
endforeach()
string(REPLACE "'" "''" adapter_quoted "${TRN_TEST_MAIL_ADAPTER}")

# PowerShell only invokes production functions and exports their results.
# Fixture construction and assertions belong to this CMake driver.
function(invoke_mail command)
    execute_process(
        COMMAND "$ENV{SystemRoot}/System32/WindowsPowerShell/v1.0/powershell.exe"
            -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command
            "$ErrorActionPreference = 'Stop'; . '${adapter_quoted}'; ${command}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
    set(mail_result "${result}" PARENT_SCOPE)
    set(mail_error "${output}${error}" PARENT_SCOPE)
endfunction()

function(require_mail_success)
    if(NOT mail_result EQUAL 0)
        message(FATAL_ERROR "Mail function failed (${mail_result}): ${mail_error}")
    endif()
endfunction()

string(ASCII 195 169 accented_e)
set(display "Andr${accented_e}")
set(headers "To: ${display} <first@example.test>,\n \"Smith, Jo\" <second@example.test>\nCc: copy@example.test\nBcc: hidden@example.test,\n hidden-two@example.test\nSubject: Reply ${display}\nIn-Reply-To: <original@example.test>\nMIME-Version: 1.0\nContent-Type: message/rfc822\n")
set(body "Subject: forward\nBcc: original-private@example.test\n\nOriginal body\n")
file(CONFIGURE OUTPUT "${draft}" CONTENT "${headers}\n${body}" @ONLY NEWLINE_STYLE LF)
file(READ "${draft}" original HEX)

invoke_mail("$submission = New-TrnMailSubmission '${draft_quoted}' author@example.test; [IO.File]::WriteAllBytes('${submission_quoted}', $submission.Bytes); [IO.File]::WriteAllText('${recipients_quoted}', (ConvertTo-Json -InputObject $submission.Recipients))")
require_mail_success()
file(READ "${recipients}" recipient_json)
string(JSON recipient_count LENGTH "${recipient_json}")
if(NOT recipient_count EQUAL 5)
    message(FATAL_ERROR "Folded recipients were lost: ${recipient_json}")
endif()

file(READ "${submission}" message)
string(REPLACE "\r\n" "\n" message "${message}")
string(FIND "${message}" "\n\n" separator)
if(separator EQUAL -1)
    message(FATAL_ERROR "Submission has no header/body separator")
endif()
string(SUBSTRING "${message}" 0 ${separator} headers)
math(EXPR body_start "${separator} + 2")
string(SUBSTRING "${message}" ${body_start} -1 body)
if(headers MATCHES "(^|\n)Bcc:" OR NOT body MATCHES "Bcc: original-private@example.test")
    message(FATAL_ERROR "Bcc sanitizing changed forwarded content or leaked an envelope header")
endif()

string(REPLACE "'" "''" headers_quoted "${headers}")
invoke_mail("$addresses = @(Get-TrnMailAddresses (Get-TrnMailHeader '${headers_quoted}' To)); [IO.File]::WriteAllText('${addresses_quoted}', (ConvertTo-Json -InputObject $addresses))")
require_mail_success()
file(READ "${addresses}" address_json)
string(JSON address_count LENGTH "${address_json}")
string(JSON second_name GET "${address_json}" 1 DisplayName)
if(NOT address_count EQUAL 2 OR NOT second_name STREQUAL "Smith, Jo")
    message(FATAL_ERROR "Display-name quoting was lost: ${address_json}")
endif()
string(HEX "${headers}" headers_hex)
if(NOT headers MATCHES "Subject: =\\?utf-8\\?B\\?" OR
   headers_hex MATCHES "^([0-9a-f][0-9a-f])*[89a-f][0-9a-f]")
    message(FATAL_ERROR "Unicode header encoding failed: ${headers}")
endif()
foreach(name IN ITEMS Date Message-ID From In-Reply-To Content-Type)
    if(NOT headers MATCHES "(^|\n)${name}: *[^\n]+")
        message(FATAL_ERROR "Missing header: ${name}")
    endif()
endforeach()
file(READ "${draft}" actual HEX)
if(NOT actual STREQUAL original)
    message(FATAL_ERROR "Submission altered the draft")
endif()

invoke_mail("[IO.File]::WriteAllText('${encoded_quoted}', (ConvertTo-TrnEncodedHeader ('${display}' * 50)))")
require_mail_success()
file(READ "${encoded}" long_header)
string(REGEX MATCHALL "[^ \t\r\n]+" words "${long_header}")
foreach(word IN LISTS words)
    string(LENGTH "${word}" length)
    if(length GREATER 75)
        message(FATAL_ERROR "Encoded word exceeds RFC 2047 limit: ${word}")
    endif()
endforeach()

invoke_mail("$null = Get-TrnMailAddresses '${display}@example.test'")
if(mail_result EQUAL 0)
    message(FATAL_ERROR "Unsupported SMTPUTF8 mailbox was not rejected")
endif()
