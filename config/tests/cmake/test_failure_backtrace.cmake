file(MAKE_DIRECTORY "${OUTPUT_DIR}")
set(TRN_TEST_LOG "${OUTPUT_DIR}/LastTestsFailed.log")
set(TRN_TEST_EXECUTABLE "${OUTPUT_DIR}/trn-test")
file(REMOVE "${TRN_TEST_LOG}" "${TRN_TEST_EXECUTABLE}")
if(NOT CASE STREQUAL "missing_log")
    file(WRITE "${TRN_TEST_LOG}" "17:FirstSuite.firstTest\n24:SecondSuite.otherTest\n")
endif()
if(NOT CASE STREQUAL "missing_binary")
    file(WRITE "${TRN_TEST_EXECUTABLE}" "fixture")
endif()
set(TRN_DEBUGGER "fake-debugger")
if(CASE STREQUAL "missing_debugger")
    unset(TRN_DEBUGGER)
endif()

function(find_program name)
    if(NOT DEFINED ${name})
        set(${name} "${name}-NOTFOUND" PARENT_SCOPE)
    endif()
endfunction()

function(execute_process)
    set(debugger_arguments "${ARGV}" PARENT_SCOPE)
endfunction()

include("${REPORT_SCRIPT}")

if(CASE STREQUAL "first")
    list(FIND debugger_arguments "--gtest_filter=FirstSuite.firstTest" first)
    list(FIND debugger_arguments "--gtest_filter=SecondSuite.otherTest" second)
    list(FIND debugger_arguments "thread apply all bt" backtrace)
    list(FIND debugger_arguments "fake-debugger" debugger)
    if(first LESS 0 OR NOT second EQUAL -1 OR backtrace LESS 0 OR debugger LESS 0)
        message(FATAL_ERROR "Expected a debugger backtrace for the first failed test: ${debugger_arguments}")
    endif()
elseif(DEFINED debugger_arguments)
    message(FATAL_ERROR "Debugger should not run for ${CASE}")
endif()
