cmake_minimum_required(VERSION 3.23)
get_filename_component(source "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
if(NOT DEFINED TRN_TEST_OUTPUT_DIR)
    message(FATAL_ERROR "TRN_TEST_OUTPUT_DIR is required.")
endif()
get_filename_component(root "${TRN_TEST_OUTPUT_DIR}" ABSOLUTE)
get_filename_component(cmake_bin "${CMAKE_COMMAND}" DIRECTORY)
set(build "${root}/build")
function(run)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 60)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "${ARGV}: ${status}\n${out}${err}")
    endif()
endfunction()
find_program(native_ed NAMES ed REQUIRED)
set(test_ed "${root}/tools/ed")
file(MAKE_DIRECTORY "${root}/tools")
file(WRITE "${test_ed}" "#!/bin/sh\nexec '${native_ed}' \"$@\"\n")
file(CHMOD "${test_ed}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
set(ENV{PATH} "${root}/tools:$ENV{PATH}")
run("${CMAKE_COMMAND}" -S "${source}/config/tests/unix-helpers" -B "${build}" "-DCMAKE_INSTALL_PREFIX=${root}/installed")
file(READ "${build}/Speller" speller)
string(FIND "${speller}" "ed=${test_ed}\n" editor_definition)
if(editor_definition EQUAL -1)
    message(FATAL_ERROR "Speller did not use the discovered ed: ${test_ed}")
endif()
run("${CMAKE_COMMAND}" --build "${build}")
set(tool "${build}/bin/pnews-test-tool")
include("${source}/config/tests/cmake/test_rnmail.cmake")
foreach(case IN ITEMS header arguments interactive inclusion loop abort eof signature record saver pgp forward)
    check_rnmail(unused "${tool}" "${root}/rnmail-${case}" "${case}")
endforeach()
run("${CMAKE_COMMAND}" --install "${build}")
function(check_package prefix label)
    foreach(name IN ITEMS filexp filexp.cmd)
        if(EXISTS "${prefix}/bin/${name}" OR EXISTS "${prefix}/lib/${name}")
            message(FATAL_ERROR "Retired helper present: ${name}")
        endif()
    endforeach()
    set(work "${root}/${label}")
    file(MAKE_DIRECTORY "${work}/home" "${work}/news")
    set(ENV{HOME} "${work}/home")
    set(ENV{LOGDIR} "${work}/home")
    set(ENV{DOTDIR} "${work}/home")
    set(ENV{PNEWS_TEST_DIRECTORY} "${work}")
    set(ENV{PNEWS_TEST_MODE} package)
    set(ENV{VISUAL} "${tool} editor")
    set(ENV{EDITOR} "${tool} editor")
    set(ENV{PGPCOMMAND} "")
    set(ENV{AUTHORCOPY} "${work}/authorcopy")
    set(ENV{MAILRECORD} "${work}/sent")
    unset(ENV{REPLYSAVER})
    set(ENV{FAST_RNMAIL} yes)
    set(ENV{FAST_PNEWS} yes)
    file(WRITE "${work}/sendmail" "#!/bin/sh\nexec '${tool}' mailer \"$@\"\n")
    file(CHMOD "${work}/sendmail" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
    set(ENV{RNMAILER} "${work}/sendmail")
    file(WRITE "${work}/mail" "To: reader@example.test\nSubject: forward\nMIME-Version: 1.0\nContent-Type: message/rfc822\n\nSubject: original\n\nforwarded body\n")
    file(WRITE "${work}/input" "s\n")
    execute_process(COMMAND sh "${prefix}/bin/Rnmail" -h "${work}/mail" INPUT_FILE "${work}/input"
        RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
    if(NOT status EQUAL 0 OR NOT EXISTS "${work}/mailed" OR NOT EXISTS "${work}/sent")
        message(FATAL_ERROR "${label} installed Rnmail: ${out}${err}")
    endif()
    file(WRITE "${work}/article" "Newsgroups: comp.test\nSubject: prepared\n\nmispelled body\n")
    file(WRITE "${work}/news/active" "comp.test 1 1 y\n")
    file(WRITE "${work}/news/newsgroups" "comp.test Test\n")
    set(ENV{NEWSACTIVE} "${work}/news/active")
    set(ENV{NEWSDESCRIPTIONS} "${work}/news/newsgroups")
    set(ENV{NEWSLIB} "${work}/news")
    set(ENV{NETSPEED} 0)
    set(ENV{TRN_VERSION} 5.0)
    set(ENV{NNTPSERVER} "")
    foreach(role IN ITEMS artcheck nntplist)
        set(name "${role}")
        if(role STREQUAL "artcheck")
            set(name trn-artchk)
        endif()
        file(WRITE "${prefix}/bin/${name}" "#!/bin/sh\nexec '${tool}' ${role} \"$@\"\n")
        file(CHMOD "${prefix}/bin/${name}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
    endforeach()
    execute_process(COMMAND sh "${prefix}/bin/Pnews" -h "${work}/article" INPUT_FILE "${work}/input"
        RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
    if(NOT status EQUAL 0 OR NOT EXISTS "${work}/posted" OR NOT EXISTS "${work}/authorcopy")
        message(FATAL_ERROR "${label} installed Pnews: ${out}${err}")
    endif()
    include("${source}/config/tests/cmake/test_norm_saver.cmake")
    check_norm_saver("${prefix}/lib/norm.saver" "${work}/normal" full)
    include("${source}/config/tests/cmake/test_mbox_saver.cmake")
    check_mbox_saver("${prefix}/lib/mbox.saver" "${work}/mailbox" full mbox)
    include("${source}/config/tests/cmake/test_speller.cmake")
    check_speller("${prefix}/lib/Speller" "${work}/spelling" correct)
    message(STATUS "${label}: five installed Unix helpers passed")
endfunction()
check_package("${root}/installed" install)
set(extract "${root}/packages/extract/trn-helper-probe")
run("${CMAKE_COMMAND}" -S "${source}/config/tests/unix-helpers" -B "${build}" "-DCMAKE_INSTALL_PREFIX=${extract}")
run("${cmake_bin}/cpack" --config "${build}/CPackConfig.cmake" -B "${root}/packages")
file(ARCHIVE_EXTRACT INPUT "${root}/packages/trn-helper-probe.zip" DESTINATION "${root}/packages/extract")
check_package("${extract}" package)

