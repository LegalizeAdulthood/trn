#pragma once

#include <cstdlib>
#include <string>
#include <string_view>

inline std::string get_env_var(std::string_view name)
{
    std::string name_text{name};
    const char *value = std::getenv(name_text.c_str());
    return value == nullptr ? std::string{} : std::string{value};
}

inline std::string get_env_var(std::string_view name, std::string_view default_value)
{
    std::string name_text{name};
    const char *value = std::getenv(name_text.c_str());
    return value == nullptr || *value == '\0' ? std::string{default_value} : std::string{value};
}

inline void set_env_var(std::string_view name, std::string_view value)
{
    std::string name_text{name};
    std::string value_text{value};
    setenv(name_text.c_str(), value_text.c_str(), 1);
}

inline void unset_env_var(std::string_view name)
{
    std::string name_text{name};
    unsetenv(name_text.c_str());
}
