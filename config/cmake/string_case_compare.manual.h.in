#pragma once

#include <string_view>

int string_case_compare(const char *s1, const char *s2);
int string_case_compare(const char *s1, const char *s2, int len);

namespace string_case_compare_detail
{
inline unsigned char fold(unsigned char ch)
{
    if (ch >= 'A' && ch <= 'Z')
    {
        return static_cast<unsigned char>(ch - 'A' + 'a');
    }
    return ch;
}
} // namespace string_case_compare_detail

inline int string_case_compare(std::string_view s1, std::string_view s2)
{
    const std::size_t len = s1.size() < s2.size() ? s1.size() : s2.size();
    for (std::size_t i = 0; i < len; ++i)
    {
        const unsigned char ch1 = string_case_compare_detail::fold(static_cast<unsigned char>(s1[i]));
        const unsigned char ch2 = string_case_compare_detail::fold(static_cast<unsigned char>(s2[i]));
        if (ch1 != ch2)
        {
            return ch1 - ch2;
        }
    }
    if (s1.size() == s2.size())
    {
        return 0;
    }
    return s1.size() < s2.size() ? -1 : 1;
}

inline bool string_case_equal(const char *s1, const char *s2)
{
    return string_case_compare(s1, s2) == 0;
}
inline int string_case_equal(const char *s1, const char *s2, int len)
{
    return string_case_compare(s1, s2, len) == 0;
}
inline bool string_case_equal(std::string_view s1, std::string_view s2)
{
    return string_case_compare(s1, s2) == 0;
}
