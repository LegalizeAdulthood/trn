#ifndef TRN_CONFIG_H
#define TRN_CONFIG_H

/* HAS_GETPWENT:
 *      This symbol, if defined, indicates that the getpwent routine is
 *      available for sequential access of the passwd database.
 *      If this is not available, the older getpw() function may be available.
 */
#cmakedefine HAS_GETPWENT

/* HAS_NEWS_ADMIN:
 *      This symbol, if defined, indicates that NEWS_ADMIN contains the login
 *      name of the news administrator.
 */
#cmakedefine HAS_NEWS_ADMIN
#define NEWS_ADMIN "@NEWS_ADMIN@"

/* NORM_SIG:
 *      This symbol, if defined, indicates that normal signal handling routines
 *      should be used, as opposed to the ones in 4.1bsd (sigset, etc.).
 */
#cmakedefine NORM_SIG

/* HAS_RDCHK:
 *      This symbol, if defined, indicates that the rdchk routine is available
 *      to find out if there is input pending on an IO channel.  Generally
 *      the routine is used only if FIONREAD and O_NDELAY aren't available.
 */
#cmakedefine HAS_RDCHK

/* HAS_SIGBLOCK:
 *      This symbol, if defined, indicates that the sigblock routine is
 *      available to block signal reception.
 */
#cmakedefine HAS_SIGBLOCK

/* HAS_SIGHOLD:
 *      This symbol, if defined, indicates that the sighold routine is
 *      available to hold signals.
 */
#cmakedefine HAS_SIGHOLD

/* HAS_VFORK:
 *      This symbol, if defined, indicates that vfork() exists.
 */
#cmakedefine HAS_VFORK

/* Signal_t:
 *      This symbol's value is either "void" or "int", corresponding to the
 *      appropriate return type of a signal handler.  Thus, you can declare
 *      a signal handler using "Signal_t (*handler)()", and define the
 *      handler using "Signal_t handler(sig)".
 */
#define Signal_t @SIGNAL_T@     // Signal handler's return type

/* USE_WIFSTAT:
 *      This symbol, if defined, indicates that WEXITSTATUS can decode the
 *      status returned by wait().
 */
#cmakedefine USE_WIFSTAT

/* DEFAULT_EDITOR:
 *      This symbol contains the full pathname of the default editor.
 */
#define DEFAULT_EDITOR "@DEFAULT_EDITOR@"

/* I_SYS_STAT:
 *      This symbol, if defined, indicates to the C program that it should
 *      include <sys/stat.h>.
 */
#cmakedefine I_SYS_STAT

/* I_SYS_IOCTL:
 *      This symbol, if defined, indicates that <sys/ioctl.h> exists and should
 *      be included. Otherwise, include <sgtty.h> or <termio.h>.
 */
/* I_SYS_FILIO:
 *      This symbol, if defined, indicates that <sys/filio.h> exists and
 *      should be included instead of <sys/ioctl.h>.
 */
#cmakedefine I_SYS_IOCTL
#cmakedefine I_SYS_FILIO

/* I_SGTTY:
 *      This symbol, if defined, indicates that <sgtty.h> exists and the
 *      terminal input path should keep sgtty-era newline normalization.
 */
#cmakedefine I_SGTTY

/* I_SYS_WAIT:
 *      This symbol, if defined, indicates to the C program that it should
 *      include <sys/wait.h>.
 */
#cmakedefine I_SYS_WAIT

/* I_TERMCAP
 *      This symbol, if defined, indicates that <termcap.h> should be included.
 */
#cmakedefine I_TERMCAP

/* I_TERMIOS:
 *      This symbol, if defined, indicates that the program should include
 *      the POSIX <termios.h> rather than <sgtty.h> or <termio.h>.
 *      There are also differences in the ioctl() calls that depend on the
 *      value of this symbol.
 */
#cmakedefine I_TERMIOS

/* I_UNISTD:
 *      This symbol, if defined, indicates to the C program that it should
 *      include <unistd.h>.
 */
#cmakedefine I_UNISTD

/* I_UTIME:
 *      This symbol, if defined, indicates to the C program that it should
 *      include <utime.h>.
 */
#cmakedefine I_UTIME

/* I_SYS_UTIME:
 *      This symbol, if defined, indicates to the C program that it should
 *      include <sys/utime.h>.
 */
#cmakedefine I_SYS_UTIME

/* I_VFORK:
 *      This symbol, if defined, indicates to the C program that it should
 *      include <vfork.h>.
 */
#cmakedefine I_VFORK

/* MAIL_FILE:
 *      This symbol contains the interpretable name of the mail spool file
 *      for the current user.  The program must be prepared to substitute
 *      the HOME directory for %~, and the login id for %L.
 */
#define MAIL_FILE "@MAIL_FILE@"

/* MBOX_CHAR:
 *      This symbol contains a character which will match the beginning
 *      of a mailbox file.
 */
#define MBOX_CHAR '@MBOX_CHAR@'

/* PASS_NAMES:
 *      This symbol, if defined, indicates that full names are stored in
 *      the /etc/passwd file.
 */
/* BERKELEY_NAMES:
 *      This symbol, if defined, indicates that full names are stored in
 *      the /etc/passwd file in Berkeley format (name first thing, everything
 *      up to first comma, with & replaced by capitalized login id, yuck).
 */
#cmakedefine PASS_NAMES // (undef to take name from FULLNAMEFILE)
#cmakedefine BERKELEY_NAMES // (that is, ":name,stuff:")

/* PASSWORD_FILE:
 *      This symbol contains the password file used for login-directory lookup
 *      when getpwent() is unavailable.
 */
#define PASSWORD_FILE "@PASSWORD_FILE@"

/* LOGIN_DIR_FIELD:
 *      This symbol contains the one-based password-file field containing login
 *      directories.
 */
#define LOGIN_DIR_FIELD @LOGIN_DIR_FIELD@

/* FULLNAMEFILE:
 *      This symbol contains the full-name file used when PASS_NAMES is
 *      disabled.
 */
#define FULLNAMEFILE "@FULLNAMEFILE@"

// TRNDIR:
//      This symbol contains the user's private trn directory.
//
#define TRNDIR "@TRNDIR@"

// TRNMACRO:
//      This symbol contains the macro file for trn mode.
//
#define TRNMACRO "@TRNMACRO@"

// RNMACRO:
//      This symbol contains the macro file for rn mode.
//
#define RNMACRO "@RNMACRO@"

// RCNAME:
//      This symbol contains the default newsrc file path.
//
#define RCNAME "@RCNAME@"

// LOCKNAME:
//      This symbol contains the newsrc lock file path.
//
#define LOCKNAME "@LOCKNAME@"

// LASTNAME:
//      This symbol contains the last-run state file path.
//
#define LASTNAME "@LASTNAME@"

// SIGNATURE_FILE:
//      This symbol contains the signature file path.
//
#define SIGNATURE_FILE "@SIGNATURE_FILE@"

// NNTP_AUTH_FILE:
//      This symbol contains the NNTP authentication file path.
//
#define NNTP_AUTH_FILE "@NNTP_AUTH_FILE@"

/* INSTALL_PREFIX:
 *      This symbol contains the name of the install prefix for this package.
 */
#define INSTALL_PREFIX "@INSTALL_PREFIX@"

/* PREF_SHELL:
 *      This symbol contains the full name of the preferred user shell on this
 *      system.  Usual values are /bin/csh, /bin/ksh, /bin/sh.
 */
#define PREF_SHELL "@PREF_SHELL@"

// SH:
//      path to fastest starting shell
//
#define SH "@SH@"

/* ROOT_UID:
 *      This symbol contains the uid of root, normally 0.
 */
#define ROOT_UID @ROOT_UID@

// UNSUBSCRIBED_CHAR:
//      This character indicates an unsubscribed newsgroup.
//
#define UNSUBSCRIBED_CHAR '@UNSUBSCRIBED_CHAR@'

// ACTIVE:
//      The name of the active file for the news system.  This file contains
//      the list of active newsgroups.  The name may have ~ on the front.
//
#define ACTIVE "@ACTIVE@"

// ACTIVE_TIMES:
//      The name of the active.times file for the news system.
//
#define ACTIVE_TIMES "@ACTIVE_TIMES@"

/* HAS_GETHOSTNAME:
 *      This symbol, if defined, indicates that the C program may use the
 *      gethostname() routine to derive the host name.
 */
/* HAS_UNAME:
 *      This symbol, if defined, indicates that the C program may use the
 *      uname() routine to derive the host name.
 */
/* PIPE_HOST_CMD:
 *      This symbol, if defined, indicates that the C program may use the
 *      contents of PIPE_HOST_CMD as a command to feed to the popen() routine
 *      to derive the host name.
 *      Note that the command uses a fully qualified path, so that it is safe
 *      even if used by a process with super-user privileges.
 */
/* HAS_RES_INIT:
 *      This symbol, if defined, indicates that the C program may use the
 *      res_init() routine to derive the domain.
 */
/* HAS_GETDOMAINNAME:
 *      This symbol, if defined, indicates that the C program may use the
 *      getdomainname() routine to derive the domain.
 */
#cmakedefine HAS_GETHOSTNAME
#cmakedefine HAS_UNAME
#cmakedefine PIPE_HOST_CMD "@PIPE_HOST_CMD@"     // How to get the host name
#cmakedefine HAS_RES_INIT
#cmakedefine HAS_GETDOMAINNAME

/* HAS_TERMLIB:
 *      This symbol, when defined, indicates that termlib-style routines
 *      are available.  There is nothing to include.
 */
#cmakedefine HAS_TERMLIB

/* IGNORE_ORG:
 *      This symbol, if defined, indicates that the ORGANIZATION environment
 *      variable does not contain an organization name.
 */
#cmakedefine IGNORE_ORG

// SERVER_NAME:
//      When using NNTP, this symbol indicates the server name or a
//      file to open to read the server name.
//
#define SERVER_NAME "@SERVER_NAME@"

// HAS_LOCAL_SPOOL:
//      This symbol, if defined, indicates that there's a local spool
//      directory configured into trn.
//
#cmakedefine HAS_LOCAL_SPOOL

/* MIMECAP:
 *      This symbol contains the pathname of mimecap file, which controls
 *      what programs get run when handling mime articles.  It is often
 *      metamail's "mailcap" file, and is the same format.
 */
#define MIMECAP "@DEFAULT_MIMECAP@"

/* NEWS_LIB:
 *      This symbol contains the name of the directory serving as the news
 *      library.  The program must be prepared to do ~ expansion on it.
 */
#define NEWS_LIB "@NEWS_LIB@"

/* EXTRA_INEWS:
 *      Contains the full path and filename of an inews to use for local
 *      postings, or nothing.
 */
#define EXTRA_INEWS "@EXTRA_INEWS@"

// GROUP_DESC:
//      Contains the full path and filename of the "newsgroups" file for
//      group descriptions, or nothing.
//
#define GROUP_DESC "@GROUP_DESC@"

// SUBSCRIPTIONS:
//      Contains the full path and filename of the list of default
//      subscriptions, or nothing.
//
#define SUBSCRIPTIONS "@SUBSCRIPTIONS@"

// NEWS_SPOOL:
//      This symbol contains the directory name where news articles are
//      spooled.  The program must be prepared to do ~ expansion on it.
//
#define NEWS_SPOOL "@NEWS_SPOOL@"

// SELECTION_CHARS:
//      default characters to use in the selection menu
//
#define SELECTION_CHARS "@SELECTION_CHARS@"

// LOCALTIME_FMT:
//      The format used by strftime() to print the local time.  The Date
//      line is only displayed in local time if the group is threaded.
//
#define LOCALTIME_FMT "@LOCALTIME_FMT@"

// MAIL_CALL:
//      check periodically for mail
//
#cmakedefine MAIL_CALL

// NO_FIREWORKS:
//      keep whole screen from flashing on certain
//      terminals such as older Televideos
//
#cmakedefine NO_FIREWORKS

// TILDE_NAME:
//      allow ~logname expansion
//
#cmakedefine TILDE_NAME

// VALIDATE_XREF_SITE:
//      are xrefs possibly invalid?
//
#cmakedefine VALIDATE_XREF_SITE

// USE_FTP:
//      if USEFTP is defined, trn will use the ftpgrab script for ftp: URLs
//      USEFTP is not very well tested, and the ftpgrab script is not
//      installed with make install.  May go away later
//
#cmakedefine USE_FTP

/* ORG_NAME:
 *      This symbol contains either the organization name or the full pathname
 *      of a file containing the organization name, which the program must
 *      be prepared to open and substitute the contents of.
 */
#define ORG_NAME "@ORG_NAME@"

/* POSTING_HOSTNAME:
 *      This symbol contains the posting host's name or a file from which
 *      to read its name.
 */
#define POSTING_HOSTNAME "@POSTING_HOSTNAME@"

/* POSTING_HOST_MATCH_SEGMENTS:
 *      Count of dot-separated hostname words to compare when looking for
 *      local articles.  Zero compares all hostname words.
 */
#define POSTING_HOST_MATCH_SEGMENTS @POSTING_HOST_MATCH_SEGMENTS@

/* MCHASE:
 *      This symbol, if defined, causes unmarking an article to also unmark
 *      cross-referenced articles in other newsgroups.
 */
#cmakedefine MCHASE

/* PRIVATE_LIB:
 *      This symbol contains the name of the private library for this package.
 *      The library is private in the sense that it needn't be in anyone's
 *      execution path, but it should be accessible by the world.  The program
 *      should be prepared to do ~ expansion.
 */
#define PRIVATE_LIB "@PRIVATE_LIB@"

// GLOBAL_INIT:
//      system-wide RNINIT switches
//
#define GLOBAL_INIT "@GLOBAL_INIT@"

// DEFACCESS:
//      trn's default access list
//
#define DEFACCESS "@DEFACCESS@"

// TRNACCESS:
//      trn's access list
//
#define TRNACCESS "@TRNACCESS@"

// NEWSNEWSNAME:
//      a motd-like file for trn
//
#define NEWSNEWSNAME "@NEWSNEWSNAME@"

// OV_FILE_NAME:
//      The name to append to the directory name to read an overview file.
//
#define OV_FILE_NAME "@OV_FILE_NAME@"

// VARYNAME:
//      virtual array file name template
//
#define VARYNAME "@VARYNAME@"

// HEADNAME:
//      file to pass header to followup article poster
//
#define HEADNAME "@HEADNAME@"

// SAVEDIR:
//      The name of the directory to save to, if the save command does not
//      specify a directory name.
//
#define SAVEDIR "@SAVEDIR@"

// SAVENAME:
//      The name of the file to save to, if the save command contains only
//      a directory name.
//
#define SAVENAME "@SAVENAME@"

// KILL_GLOBAL:
//      Where to find the KILL file to apply to every newsgroup.  See
//      the ^K command at the newsgroup-selection level.
//
#define KILL_GLOBAL "@KILL_GLOBAL@"

// KILL_LOCAL:
//      Where to find the KILL file for the current newsgroup.  See
//      the commands K and ^K at the article selection level, and the
//      search modifier K.
//
#define KILL_LOCAL "@KILL_LOCAL@"

// KILL_THREADS:
//      Where to find the global thread kill file.
//
#define KILL_THREADS "@KILL_THREADS@"

// PIPE_SAVER:
//      The shell command to execute for a save to a pipe ("s | command"
//      or "w | command").  The command typed by the user is substituted
//      in as %b.
//
#define PIPE_SAVER R"trn(@PIPE_SAVER@)trn"

// SHAR_SAVER:
//      The shell command to execute to extract a shell archive.
//
#define SHAR_SAVER R"trn(@SHAR_SAVER@)trn"

// CUSTOM_SAVER:
//      The shell command to execute to extract data with a user-specified
//      command.
//
#define CUSTOM_SAVER R"trn(@CUSTOM_SAVER@)trn"

// VERIFY_RIPEM:
//      The shell command to verify a RIPEM signature.
//
#define VERIFY_RIPEM "@VERIFY_RIPEM@"

// VERIFY_PGP:
//      The shell command to verify a PGP signature.
//
#define VERIFY_PGP "@VERIFY_PGP@"

// MAIL_HEADER:
//      The header template used when mailing a reply.
//
#define MAIL_HEADER "@MAIL_HEADER@"

// NEWS_HEADER:
//      The header template used when posting a followup article.
//
#define NEWS_HEADER "@NEWS_HEADER@"

// CANCEL_HEADER:
//      The header template used when canceling an article.
//
#define CANCEL_HEADER "@CANCEL_HEADER@"

// SUPERSEDE_HEADER:
//      The header template used when superseding an article.
//
#define SUPERSEDE_HEADER "@SUPERSEDE_HEADER@"

// OVERVIEW_DIR:
//      This symbol indicates where the overview files go.
//
#define OVERVIEW_DIR "@OVERVIEW_DIR@"

// OVERVIEW_FMT:
//      The overview.fmt file.
//
#define OVERVIEW_FMT "@OVERVIEW_FMT@"

/* THREAD_INIT:
 *      This symbol indicates we act like trn no matter what our name is.
 */
/* SELECT_INIT:
 *      This symbol indicates we default to the selector for group entry.
 */
#cmakedefine01 THREAD_INIT
#cmakedefine01 SELECT_INIT

// CALL_INEWS:
//      how to cancel an article
//
#define CALL_INEWS "@CALL_INEWS@"

// NEWS_POSTER:
//      command to submit a followup article
//
#define NEWS_POSTER R"trn(@NEWS_POSTER@)trn"

// MAIL_POSTER:
//      command to send a reply
//
#define MAIL_POSTER R"trn(@MAIL_POSTER@)trn"

// YOU_SAID:
//      Gives the format of the attribution line in front of the quoted
//      article included by an R (reply-by-mail) command.
//
#define YOU_SAID "@YOU_SAID@"

// ATTRIBUTION:
//      Gives the format of the attribution line in front of the quoted
//      article included by an F (followup) command.
//
#define ATTRIBUTION "@ATTRIBUTION@"

// FORWARD_POSTER:
//      The shell command to be used by the forward command (^F) in order
//      to allow you to edit and deliver the file.  trn will not itself
//      call upon an editor for replies -- this is a function of the
//      program referenced by FORWARD_POSTER.  See also FORWARD_HEADER and
//      MAIL_POSTER.
//
#define FORWARD_POSTER R"trn(@FORWARD_POSTER@)trn"

// FORWARD_HEADER:
//      The format of the header file for forwarding messages.  If these
//      headers contain a Content-Type header with a multipart/* type,
//      Rnmail will attempt to forward the message MIME-encapsulated.
//      This may fail if you are using a non-standard FORWARD_POSTER
//      which does not pass on MIME headers properly.  See also
//      FORWARD_POSTER.
//
#define FORWARD_HEADER "@FORWARD_HEADER@"

// FORWARD_MSG:
//      The line added to the message body when forwarding a message,
//      signifying the beginning of the forwarded message.  This is only
//      added if the message is not being forwarded as a MIME attachment
//      (see FORWARD_HEADER).
//
#define FORWARD_MSG "@FORWARD_MSG@"

// FORWARD_MSG_END:
//      The line added to the message body when forwarding a message,
//      signifying the end of the forwarded message.  This is only added
//      if the message is not being forwarded as a MIME attachment (see
//      FORWARD_HEADER).
//
#define FORWARD_MSG_END "@FORWARD_MSG_END@"

/* MSDOS:
 *      This is defined if this is an MSDOS system.
 */
#cmakedefine MSDOS

// USE_CONIO_TERMINAL_INPUT:
//      This symbol, if defined, indicates that terminal input should use
//      the conio kbhit() and getch() routines.
//
#cmakedefine USE_CONIO_TERMINAL_INPUT

// USE_BUILTIN_TERMINAL_CAPABILITIES:
//      This symbol, if defined, indicates that trn should use built-in
//      terminal capability strings instead of reading termcap entries.
//
#cmakedefine USE_BUILTIN_TERMINAL_CAPABILITIES

// USE_SPAWN_SHELL:
//      This symbol, if defined, indicates that shell commands should be
//      launched with a spawn-style wait call.
//
#cmakedefine USE_SPAWN_SHELL

// USE_UNDERSCORE_SLEEP:
//      This symbol, if defined, indicates that sleep() should use the
//      C runtime _sleep() routine.
//
#cmakedefine USE_UNDERSCORE_SLEEP

// USE_WINDOWS_ENVIRONMENT_NAMES:
//      This symbol, if defined, indicates that Windows environment names
//      should be used for login and home-directory fallback lookup.
//
#cmakedefine USE_WINDOWS_ENVIRONMENT_NAMES

// USE_WINDOWS_FILENAME_RULES:
//      This symbol, if defined, indicates that decoded filenames should
//      follow Windows filename restrictions.
//
#cmakedefine USE_WINDOWS_FILENAME_RULES

// CHECK_NEWSRC_LOCK_PROCESS:
//      This symbol, if defined, indicates that stale newsrc locks can be
//      checked against live process IDs.
//
#cmakedefine CHECK_NEWSRC_LOCK_PROCESS

// SET_ARTICLE_TEMP_FILE_PERMISSIONS:
//      This symbol, if defined, indicates that fetched article temporary
//      files should be made private with file permissions.
//
#cmakedefine SET_ARTICLE_TEMP_FILE_PERMISSIONS

// PRESERVE_NEWSRC_FILE_PERMISSIONS:
//      This symbol, if defined, indicates that rewritten newsrc files
//      should preserve the old file's mode and ownership.
//
#cmakedefine PRESERVE_NEWSRC_FILE_PERMISSIONS

/* REPLYTO_POSTER_CHECKING:
 *      Makes -p also check Reply-To (slow)
 */
#cmakedefine REPLYTO_POSTER_CHECKING

/* DEBUG:
 *      If this is defined, debug logging is enabled in trn.
 */
#cmakedefine DEBUG

#endif
