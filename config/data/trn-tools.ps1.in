#requires -Version 5.1

function Get-TrnSetting([string] $Name, [string] $Default) {
    $value = [Environment]::GetEnvironmentVariable($Name)
    if ($null -eq $value) { return $Default }
    return $value
}

function Split-TrnArguments([string] $Text) {
    $pattern = [regex]::new('\G\s*(?:"([^"]*)"|''([^'']*)''|([^\s"'']+))')
    $position = 0
    while ($position -lt $Text.Length) {
        if ($Text.Substring($position).Trim().Length -eq 0) { break }
        $match = $pattern.Match($Text, $position)
        if (!$match.Success) { throw 'Unmatched quote in tool command.' }
        foreach ($group in 1..3) {
            if ($match.Groups[$group].Success) { $match.Groups[$group].Value; break }
        }
        $position += $match.Length
    }
}

function ConvertTo-TrnArgument([string] $Argument) {
    $quoted = [regex]::Replace($Argument, '(\\*)"', '$1$1\"')
    return '"' + [regex]::Replace($quoted, '(\\+)$', '$1$1') + '"'
}

function Start-TrnProcess([Diagnostics.Process] $Process, [bool] $RedirectInput = $false) {
    if (!$RedirectInput) { [void] $Process.Start(); return }
    if (!('TrnRawInput' -as [type])) {
        Add-Type -TypeDefinition @'
using System;
using System.ComponentModel;
using System.Diagnostics;
using System.IO.Pipes;
using System.Runtime.InteropServices;

public static class TrnRawInput {
    [DllImport("kernel32.dll", SetLastError = true)]
    private static extern IntPtr GetStdHandle(int device);
    [DllImport("kernel32.dll", SetLastError = true)]
    [return: MarshalAs(UnmanagedType.Bool)]
    private static extern bool SetStdHandle(int device, IntPtr handle);

    public static void Start(Process process, AnonymousPipeServerStream input) {
        lock (typeof(TrnRawInput)) {
            IntPtr previous = GetStdHandle(-10);
            if (!SetStdHandle(-10, input.ClientSafePipeHandle.DangerousGetHandle()))
                throw new Win32Exception();
            try {
                if (!process.Start()) throw new InvalidOperationException("Tool did not start.");
            }
            finally {
                if (!SetStdHandle(-10, previous)) throw new Win32Exception();
            }
        }
        input.DisposeLocalCopyOfClientHandle();
    }
}
'@
    }
    # Inherit a byte pipe instead of .NET Framework's preamble-emitting writer.
    $inputPipe = [IO.Pipes.AnonymousPipeServerStream]::new(
        [IO.Pipes.PipeDirection]::Out, [IO.HandleInheritability]::Inheritable)
    try {
        [TrnRawInput]::Start($Process, $inputPipe)
        return $inputPipe
    }
    catch { $inputPipe.Dispose(); throw }
}

# Console tools inherit the terminal. Streamed tools receive bytes directly,
# without PowerShell's text pipeline or its implicit encoding conversions.
function Invoke-TrnTool([string] $Command, [string[]] $Arguments,
    [string] $InputPath = '', [string] $OutputPath = '') {
    if ([IO.File]::Exists($Command)) { $parts = @($Command) }
    else { $parts = @(Split-TrnArguments $Command) }
    if ($parts.Count -eq 0) { throw 'No tool configured.' }
    $program = $parts[0]
    $toolArguments = @($parts | Select-Object -Skip 1) + $Arguments
    $global:LASTEXITCODE = 0
    if (!$InputPath -and !$OutputPath) {
        & $program @toolArguments
        if ($LASTEXITCODE -ne 0) { throw "$program exited with status $LASTEXITCODE." }
        return
    }
    if ([IO.Path]::GetExtension($program) -ieq '.ps1') {
        $toolArguments = @('-NoLogo', '-NoProfile', '-ExecutionPolicy', 'Bypass', '-File', $program) + $toolArguments
        $program = Join-Path $env:SystemRoot 'System32\WindowsPowerShell\v1.0\powershell.exe'
    }
    if ([IO.Path]::GetExtension($program) -imatch '^\.(cmd|bat)$') {
        throw 'Streamed tools must be native executables or PowerShell scripts.'
    }
    $process = [Diagnostics.Process]::new()
    $source = $null
    $destination = $null
    $inputPipe = $null
    try {
        $process.StartInfo.FileName = $program
        $process.StartInfo.Arguments = (@($toolArguments | ForEach-Object { ConvertTo-TrnArgument $_ }) -join ' ')
        $process.StartInfo.UseShellExecute = $false
        $process.StartInfo.RedirectStandardOutput = [bool] $OutputPath
        $inputPipe = Start-TrnProcess $process ([bool] $InputPath)
        $copy = $null
        if ($OutputPath) {
            $destination = [IO.File]::Create($OutputPath)
            $copy = $process.StandardOutput.BaseStream.CopyToAsync($destination)
        }
        if ($InputPath) {
            $source = [IO.File]::OpenRead($InputPath)
            $source.CopyTo($inputPipe)
            $inputPipe.Dispose()
        }
        $process.WaitForExit()
        if ($null -ne $copy) { $null = $copy.GetAwaiter().GetResult() }
        if ($process.ExitCode -ne 0) { throw "$program exited with status $($process.ExitCode)." }
    }
    finally {
        if ($source) { $source.Dispose() }
        if ($destination) { $destination.Dispose() }
        if ($inputPipe) { $inputPipe.Dispose() }
        $process.Dispose()
    }
}
